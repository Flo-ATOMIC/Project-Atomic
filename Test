-- ==== 4. Scanner de remotes ====
local function searchRemotes(container, keywords)
    keywords = keywords or {"boss", "spawn", "summon", "activate"}
    local found = {}
    local function recursiveSearch(obj, path)
        if not obj then return end
        for _, child in ipairs(obj:GetChildren()) do
            if child:IsA("RemoteFunction") or child:IsA("RemoteEvent") then
                local name = child.Name:lower()
                for _, kw in ipairs(keywords) do
                    if name:find(kw) then
                        table.insert(found, {remote = child, path = path .. "/" .. child.Name, type = child.ClassName})
                        break
                    end
                end
            end
            recursiveSearch(child, path .. "/" .. child.Name)
        end
    end
    recursiveSearch(container, container.Name)
    return found
end

