local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- 🎯 LISTE DE TES PETS
local SEARCH_ORDER = {
    "The Ethereal Everia", "The Grand Titan", "Frozen Dragon", "Enchanted Pegasus",
    "Great Auk", "The Frozen Ancient", "Lava Monster", "Ghost Pirate",
    "King Desert Slime", "Big 100M", "Naga", "Tiki", "Hornet",
    "Ice Serpent", "King Julian", "Inferno Bee", "Black Ice Bee"
}

print("✅ Script de recherche chargé. Ouvre le menu de trade manuellement.")

-- On attend que tu ouvres l'interface de trade
local TradingGui = PlayerGui:WaitForChild("Trading")
local TradeFrame = TradingGui.Container.Frame
local SearchBar = TradeFrame.CurInventory.Search:FindFirstChildOfClass("TextBox")

local function typeSearch(text)
    SearchBar:CaptureFocus()
    SearchBar.Text = text
    SearchBar:ReleaseFocus()
end

-- Le script va te guider pas à pas
for i, petName in ipairs(SEARCH_ORDER) do
    typeSearch(petName)
    print("👉 ["..i.."/"..6.."] Clique sur le pet : " .. petName)
    
    -- On attend 3 secondes pour que tu aies le temps de cliquer sur le pet
    task.wait(3) 
end

typeSearch("")
print("✅ Tous les pets ont été recherchés. Clique sur READY !")
