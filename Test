local PlayerGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")

local SEARCH_ORDER = {
    "1. The Ethereal Everia", "2. The Grand Titan", "3. Frozen Dragon", 
    "4. Enchanted Pegasus", "5. Great Auk", "6. The Frozen Ancient",
    "7. Lava Monster", "8. Ghost Pirate", "9. King Desert Slime", 
    "10. Big 100M", "11. Naga", "12. Tiki"
}

-- Création d'une interface simple à l'écran
local gui = Instance.new("ScreenGui")
gui.Name = "TradeHelper"
gui.ResetOnSpawn = false
gui.Parent = PlayerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 200, 0, 400)
frame.Position = UDim2.new(1, -210, 0.5, -200)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
frame.BorderSizePixel = 0
frame.Parent = gui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.BackgroundTransparency = 1
title.Text = "Ordre des Pets"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.Font = Enum.Font.FredokaOne
title.TextSize = 18
title.Parent = frame

local scroll = Instance.new("ScrollingFrame")
scroll.Size = UDim2.new(1, 0, 1, -30)
scroll.Position = UDim2.new(0, 0, 0, 30)
scroll.BackgroundTransparency = 1
scroll.ScrollBarThickness = 2
scroll.Parent = frame

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 5)
layout.Parent = scroll

for _, text in ipairs(SEARCH_ORDER) do
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 25)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(200, 200, 200)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Gotham
    label.TextSize = 14
    label.Parent = scroll
end
