    "Naga", "Lava Monster", "Ghost Pirate", "Tiki Monster", "The Frozen Ancient", "The Big 100M",
    "The Ethereal Everia", "Hornet Boss", "The Ice Serpent", "Great Sphinx"
}

-- ==== 4. Fonction pour tester un appel ====
local function testSpawn(remote, args, description)
    if not remote then
        log("Remote nil, impossible de tester")
        return false
    end
    local success, err = pcall(function()
        remote:FireServer(table.unpack(args))
    end)
    if success then
        log("[SUCCESS]", description, "avec args:", table.unpack(args))
        notify("Test OK", description, 2)
        return true
    else
        log("[ERROR]", description, ":", err)
        return false
    end
end

-- ==== 5. Fonction pour vérifier l'apparition d'un boss ====
local function checkBossAppeared(zoneName, bossName)
    local zone = Workspace.Zones:FindFirstChild(zoneName)
    if not zone then return false end
    local enemies = zone:FindFirstChild("Enemies")
    if not enemies then return false end
    return enemies:FindFirstChild(bossName) ~= nil
end

-- ==== 6. Tests automatiques ====
local function runAllTests()
    log("=== DÉBUT DES TESTS ===")
    
    -- Tester avec différentes combinaisons
    local testCases = {
        {args = {"Spawn"}, desc = "Spawn"},
        {args = {"Summon"}, desc = "Summon"},
        {args = {"Boss"}, desc = "Boss"},
        {args = {"Naga"}, desc = "Naga"},
        {args = {"Zone2B1"}, desc = "Zone2B1"},
        {args = {"Naga", "Zone2B1"}, desc = "Naga+Zone"},
        {args = {"Zone2B1", "Naga"}, desc = "Zone+Naga"},
        {args = {"Activate"}, desc = "Activate"},
        {args = {"Start"}, desc = "Start"},
        {args = {"Spawn", "Naga"}, desc = "Spawn+Naga"},
        {args = {"Spawn", "Zone2B1"}, desc = "Spawn+Zone"},
        {args = {"Summon", "Naga"}, desc = "Summon+Naga"},
        {args = {"Summon", "Zone2B1"}, desc = "Summon+Zone"},
        {args = {"Boss", "Naga"}, desc = "Boss+Naga"},
        {args = {"Boss", "Zone2B1"}, desc = "Boss+Zone"},
        {args = {1}, desc = "1"},
        {args = {true}, desc = "true"},
        {args = {false}, desc = "false"},
        {args = {}, desc = "aucun argument"},
    }

    -- Ajouter des tests pour chaque boss avec différentes combinaisons
    for _, bossName in ipairs(bossList) do
        local zoneName = bossZoneMap[bossName]
        table.insert(testCases, {args = {bossName}, desc = "Boss:" .. bossName})
        table.insert(testCases, {args = {zoneName}, desc = "Zone:" .. zoneName})
        table.insert(testCases, {args = {zoneName, bossName}, desc = "Zone+Boss:" .. zoneName .. "+" .. bossName})
        table.insert(testCases, {args = {"Spawn", bossName}, desc = "Spawn+" .. bossName})
        table.insert(testCases, {args = {"Summon", bossName}, desc = "Summon+" .. bossName})
        table.insert(testCases, {args = {"Boss", bossName}, desc = "Boss+" .. bossName})
        table.insert(testCases, {args = {"Spawn", zoneName}, desc = "Spawn+" .. zoneName})
        table.insert(testCases, {args = {"Summon", zoneName}, desc = "Summon+" .. zoneName})
        table.insert(testCases, {args = {"Boss", zoneName}, desc = "Boss+" .. zoneName})
        table.insert(testCases, {args = {"Spawn", zoneName, bossName}, desc = "Spawn+Zone+Boss"})
        table.insert(testCases, {args = {"Summon", zoneName, bossName}, desc = "Summon+Zone+Boss"})
        table.insert(testCases, {args = {"Boss", zoneName, bossName}, desc = "Boss+Zone+Boss"})
    end

    -- Exécuter tous les tests
    for i, test in ipairs(testCases) do
        log("Test " .. i .. "/" .. #testCases .. ": " .. test.desc)
        local ok = testSpawn(BossesEvent, test.args, test.desc)
        if ok then
            -- Vérifier si un boss est apparu dans les 2 secondes
            task.wait(0.5) -- laisser le temps au serveur de réagir
            for _, bossName in ipairs(bossList) do
                local zoneName = bossZoneMap[bossName]
                if checkBossAppeared(zoneName, bossName) then
                    notify("BOSS SPAWNÉ !", bossName .. " est apparu après : " .. test.desc, 5)
                    log(">>> BOSS SPAWNÉ !", bossName, "avec", test.desc)
                    -- On peut stopper les tests pour ne pas surcharger
                    return
                end
            end
        end
        task.wait(0.2) -- petit délai entre les tests
    end

    log("=== FIN DES TESTS ===")
    notify("Tests terminés", "Aucun boss n'est apparu. Voir console F9.", 5)
end

-- ==== 7. Bouton de test manuel avec arguments personnalisés ====
-- Interface simple avec input pour tester manuellement
local function manualTest()
    local args = {}
    local input = prompt("Entrez les arguments séparés par des virgules (ex: Spawn,Naga)")
    if input then
        for word in string.gmatch(input, "[^,]+") do
            table.insert(args, word)
        end
        log("Test manuel avec args:", table.unpack(args))
        local ok = testSpawn(BossesEvent, args, "manuel")
        if ok then
            task.wait(1)
            for _, bossName in ipairs(bossList) do
                local zoneName = bossZoneMap[bossName]
                if checkBossAppeared(zoneName, bossName) then
                    notify("BOSS SPAWNÉ !", bossName, 5)
                end
            end
        end
    end
end

