local function updatePets()
    local pets = {}
    if LocalPlayer.Character then
        local petsObj = LocalPlayer.Character:FindFirstChild("Pets")
        if petsObj then
            for _, v in ipairs(petsObj:GetChildren()) do
                table.insert(pets, v)
            end
        end
    end
    return pets
end

local function safeAttackEnemy(enemy, pet)
    if CombatRemote and enemy and pet then
        pcall(CombatRemote.InvokeServer, CombatRemote, "AttackEnemy", enemy, pet)
    end
end

-- ==== 6. SCAN DES REMOTES (complet) ====
local function scanAllRemotes()
    log("=== SCAN DE TOUS LES REMOTES ===")
    local function scan(container, path)
        if not container then return end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("RemoteFunction") or child:IsA("RemoteEvent") then
                log(path .. "/" .. child.Name, "Type:", child.ClassName)
            end
            scan(child, path .. "/" .. child.Name)
        end
    end
    scan(ReplicatedStorage, "ReplicatedStorage")
    log("=== FIN DU SCAN ===")
    notify("Scan terminé", "Consultez la console (F9).", 4)
end

-- ==== 7. SCAN DE WORKSPACE (ClickDetectors / ProximityPrompts) ====
local altarObjects = {} -- cache

local function scanWorkspaceForAltars()
    altarObjects = {}
    log("=== SCAN DE WORKSPACE POUR INTERACTIONS ===")
    for _, bossName in ipairs(bossList) do
        local zoneName = bossZoneMap[bossName]
        local zone = Workspace.Zones:FindFirstChild(zoneName)
        if zone then
            -- Recherche de ClickDetectors ou ProximityPrompts dans toute la zone
            for _, child in ipairs(zone:GetDescendants()) do
                if child:IsA("ClickDetector") then
                    local parent = child.Parent
                    if parent and parent:IsA("BasePart") then
                        log("ClickDetector trouvé dans", zoneName, "sur", parent.Name)
                        table.insert(altarObjects, {detector = child, part = parent, zone = zoneName})
                    end
                elseif child:IsA("ProximityPrompt") then
                    log("ProximityPrompt trouvé dans", zoneName, "sur", child.Parent and child.Parent.Name or "inconnu")
                    table.insert(altarObjects, {prompt = child, zone = zoneName})
                end
            end
        end
    end
    log("=== FIN SCAN ===")
    notify("Scan Workspace", #altarObjects .. " interactions trouvées.", 4)
end

-- ==== 8. FORCE SPAWN VIA REMOTE (si trouvé) ====
local spawnRemote = nil
local spawnRemoteType = nil

local function findSpawnRemote()
    if spawnRemote then return spawnRemote end

    local keywords = {"boss", "spawn", "summon", "activate", "start", "encounter", "npc", "enemy"}
    local function search(container)
        if not container then return nil end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("RemoteFunction") or child:IsA("RemoteEvent") then
                local name = child.Name:lower()
                for _, kw in ipairs(keywords) do
                    if name:find(kw) then
                        return child
                    end
                end
            end
            local found = search(child)
            if found then return found end
        end
        return nil
    end

    local remote = search(Remotes)
    if not remote then
        remote = search(ReplicatedStorage)
    end

    if remote then
        spawnRemote = remote
        spawnRemoteType = remote:IsA("RemoteFunction") and "Function" or "Event"
        log("Remote de spawn potentiel trouvé:", remote.Name, "Type:", spawnRemoteType)
        notify("Remote trouvé", remote.Name, 3)
    else
        log("Aucun remote contenant les mots-clés trouvé.")
    end
    return remote
end

local function tryInvoke(remote, args)
    if not remote then return false end
    local ok, err = pcall(function()
        if remote:IsA("RemoteFunction") then
            remote:InvokeServer(table.unpack(args))
        else
            remote:FireServer(table.unpack(args))
        end
    end)
    if not ok then
        log("Erreur d'appel:", err)
    end
    return ok
end

function forceBossSpawn()
    if not config.bossSpawnBooster then return end

    local remote = findSpawnRemote()
    if remote then
        for _, bossName in ipairs(bossList) do
            if bossEnabled[bossName] then
                local zoneName = bossZoneMap[bossName]
                if zoneName then
                    local combos = {
                        {zoneName},
                        {bossName},
                        {zoneName, bossName},
                        {}
                    }
                    for _, args in ipairs(combos) do
                        if tryInvoke(remote, args) then
                            log("Spawn déclenché pour", bossName, "avec", unpack(args))
                            break
                        end
                    end
                    task.wait(0.1)
                end
            end
        end
    end

    -- Même si un remote est trouvé, on tente aussi les clics sur les autels (si activé)
    if config.clickAltars then
        clickAllAltars()
    end
end

-- ==== 9. CLIC SUR LES AUTELS / INTERACTIONS ====
function clickAllAltars()
    if #altarObjects == 0 then
        -- Si le cache est vide, on le scanne
        scanWorkspaceForAltars()
    end
    for _, obj in ipairs(altarObjects) do
        if obj.detector and obj.detector:IsA("ClickDetector") then
            local success, err = pcall(function()
                obj.detector:Click(LocalPlayer)
            end)
            if success then
                log("Clic effectué sur", obj.detector.Parent and obj.detector.Parent.Name or "inconnu")
            else
                log("Erreur clic:", err)
            end
        elseif obj.prompt and obj.prompt:IsA("ProximityPrompt") then
            -- Pour les ProximityPrompt, on peut essayer de l'activer
            local success, err = pcall(function()
                obj.prompt:InputHoldBegin(LocalPlayer) -- ou InputHoldEnd / Action
            end)
            if success then
                log("Prompt activé dans", obj.zone)
            else
                log("Erreur prompt:", err)
            end
        end
        task.wait(0.2)
    end
end

-- ==== 10. AUTO-KILL (accélération) ====
local function autoKillBosses()
    if not config.autoKillBosses then return end
    local pets = updatePets()
    if #pets == 0 then return end

    for _, bossName in ipairs(bossList) do
        if bossEnabled[bossName] then
            local zone = Workspace.Zones:FindFirstChild(bossZoneMap[bossName])
            if zone then
                local enemies = zone:FindFirstChild("Enemies")
                if enemies then
                    local boss = enemies:FindFirstChild(bossName)
                    if boss and CombatRemote then
                        for _ = 1, 10 do
                            pcall(CombatRemote.InvokeServer, CombatRemote, "AttackEnemy", boss, pets[1])
                            task.wait(0.005)
                        end
                        log("Auto-kill sur", bossName)
                    end
                end
            end
        end
    end
end

-- ==== 11. Attaque normale des boss ====
local function attackBosses()
    if not config.farmBosses then return end
    local pets = updatePets()
    if #pets == 0 then return end
    for _, bossName in ipairs(bossList) do
        if bossEnabled[bossName] then
            local zone = Workspace.Zones:FindFirstChild(bossZoneMap[bossName])
            if zone then
                local enemies = zone:FindFirstChild("Enemies")
                if enemies then
                    local boss = enemies:FindFirstChild(bossName)
                    if boss then
                        safeAttackEnemy(boss, pets[1])
                        task.wait(config.bossAttackDelay)
                    end
                end
            end
        end
    end
end

