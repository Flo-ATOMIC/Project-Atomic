    end
end

-- ==== 5. Force Spawn (méthodes multiples) ====
local bossSpawnRemote = nil
local bossSpawnRemoteType = nil
local bossSpawnRemoteFound = false

function findBestRemote()
    if bossSpawnRemoteFound then return bossSpawnRemote end
    local candidates = searchRemotes(ReplicatedStorage, {"boss", "spawn", "summon"})
    -- On privilégie ceux qui contiennent "boss" ET "spawn"
    for _, info in ipairs(candidates) do
        local name = info.remote.Name:lower()
        if name:find("boss") and name:find("spawn") then
            bossSpawnRemote = info.remote
            bossSpawnRemoteType = info.type
            bossSpawnRemoteFound = true
            notify("Remote trouvé", info.remote.Name .. " (" .. info.type .. ")", 3)
            return bossSpawnRemote
        end
    end
    -- Sinon on prend le premier qui contient "boss"
    for _, info in ipairs(candidates) do
        if info.remote.Name:lower():find("boss") then
            bossSpawnRemote = info.remote
            bossSpawnRemoteType = info.type
            bossSpawnRemoteFound = true
            notify("Remote trouvé (fallback)", info.remote.Name .. " (" .. info.type .. ")", 3)
            return bossSpawnRemote
        end
    end
    -- Dernier recours : on prend n'importe quel remote de la liste
    if #candidates > 0 then
        bossSpawnRemote = candidates[1].remote
        bossSpawnRemoteType = candidates[1].type
        bossSpawnRemoteFound = true
        notify("Remote trouvé (any)", candidates[1].remote.Name, 3)
        return bossSpawnRemote
    end
    return nil
end

local function attemptSpawnWithArgs(remote, args)
    if not remote then return false end
    local success = false
    if remote:IsA("RemoteFunction") then
        success = pcall(remote.InvokeServer, remote, table.unpack(args))
    elseif remote:IsA("RemoteEvent") then
        success = pcall(remote.FireServer, remote, table.unpack(args))
    end
    return success
end

function forceBossSpawn()
    if not config.bossSpawnBooster then return end

    local remote = findBestRemote()
    if not remote then
        -- Si aucun remote trouvé, on essaye une méthode alternative : interagir avec les objets de zone (ex: des autels)
        tryInteractWithZoneObjects()
        return
    end

    -- Méthodes d'appel selon la configuration
    local method = config.forceSpawnMethod
    for _, bossName in ipairs(bossList) do
        if bossEnabled[bossName] then
            local zoneName = bossZoneMap[bossName]
            if zoneName then
                local success = false
                -- Méthode 1: avec zone
                if method == "auto" or method == "zone" then
                    success = attemptSpawnWithArgs(remote, {zoneName})
                end
                -- Méthode 2: avec nom du boss
                if not success and (method == "auto" or method == "bossname") then
                    success = attemptSpawnWithArgs(remote, {bossName})
                end
                -- Méthode 3: avec les deux
                if not success and (method == "auto" or method == "both") then
                    success = attemptSpawnWithArgs(remote, {zoneName, bossName})
                end
                -- Méthode 4: sans argument
                if not success then
                    success = attemptSpawnWithArgs(remote, {})
                end
                if success then
                    -- On a réussi un appel, on passe au boss suivant
                end
                task.wait(0.1)
            end
        end
    end
end

-- Méthode alternative : cliquer sur des boutons UI ou interagir avec des objets
function tryInteractWithZoneObjects()
    -- Exemple : chercher des autels de boss dans les zones
    for _, bossName in ipairs(bossList) do
        if bossEnabled[bossName] then
            local zoneName = bossZoneMap[bossName]
            local zone = Workspace.Zones:FindFirstChild(zoneName)
            if zone then
                -- Chercher un objet nommé "BossAltar" ou "Summon" dans la zone
                for _, child in ipairs(zone:GetDescendants()) do
                    if child:IsA("BasePart") and (child.Name:lower():find("altar") or child.Name:lower():find("summon") or child.Name:lower():find("boss")) then
                        -- Simuler un clic ou une interaction
                        local clickDetector = child:FindFirstChildOfClass("ClickDetector")
                        if clickDetector then
                            pcall(clickDetector.Click, clickDetector, LocalPlayer)
                        end
                        -- Ou utiliser un remote d'interaction
                        local interactRemote = child:FindFirstChild("InteractRemote")
                        if interactRemote then
                            pcall(interactRemote.FireServer, interactRemote, LocalPlayer)
                        end
                    end
                end
            end
        end
    end
end

-- ==== 6. Auto-Kill Boss (pour accélérer le cycle) ====
local function autoKillBosses()
    if not config.autoKillBosses then return end
    -- On tue tous les boss présents en les attaquant avec une vitesse maximale
    local pets = getPets()
    if #pets == 0 then return end
    for _, bossName in ipairs(bossList) do
        if bossEnabled[bossName] then
            local zone = Workspace.Zones:FindFirstChild(bossZoneMap[bossName])
            if zone then
                local enemies = zone:FindFirstChild("Enemies")
                if enemies then
                    local boss = enemies:FindFirstChild(bossName)
                    if boss then
                        -- Attaquer avec le premier pet en boucle très rapide
                        for _ = 1, 3 do
                            pcall(function()
                                if CombatRemote then
                                    CombatRemote:InvokeServer("AttackEnemy", boss, pets[1])
                                end
                            end)
                            task.wait(0.01)
                        end
                    end
                end
            end
        end
    end
end

