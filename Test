Button.MouseButton1Click:Connect(function()
    local key = TextBox.Text
    MsgLabel.TextColor3 = Color3.fromRGB(255, 255, 50)
    MsgLabel.Text = "Vérification en cours..."

    task.wait(1) 
    
    if key == "TEST" then
        MsgLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
        MsgLabel.Text = "Clé validée ! Chargement..."
        task.wait(1)
        ScreenGui:Destroy() -- Ferme le menu
        
        -- ✅ ON CHARGE LE SCRIPT DE FREEZE ICI
        print("[ProjectAtomic] Authentification réussie. Lancement du Freeze Trade...")
        
        -- On vérifie si hookmetamethod existe
        local hookmetamethod = hookmetamethod or (getgenv and getgenv().hookmetamethod) or (syn and syn.hookmetamethod)
        local getnamecallmethod = getnamecallmethod or (getgenv and getgenv().getnamecallmethod)

        if type(hookmetamethod) == "function" then
            local Config = { FreezeEnabled = false }
            
            local oldNameCall
            oldNameCall = hookmetamethod(game, "__namecall", function(self, ...)
                local method = getnamecallmethod()
                if method == "FireServer" or method == "InvokeServer" then
                    if typeof(self) == "Instance" and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
                        if self:GetFullName():find("TradingUtils") and Config.FreezeEnabled then
                            if self.Name == "Accept1" or self.Name == "Accept2" then
                                print("[ProjectAtomic] ⛔ Accept bloqué !")
                                return
                            end
                        end
                    end
                end
                return oldNameCall(self, ...)
            end)
            print("[ProjectAtomic] Hook réseau activé avec succès.")
        else
            warn("[ProjectAtomic] Attention : Ton exécuteur bloque les hooks réseau.")
        end
        
        -- On lance Fluent (si ton exécuteur le supporte)
        local successFluent, Fluent = pcall(function()
            return loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
        end)
        
        if successFluent and Fluent then
             local Window = Fluent:CreateWindow({
                Title = "Project Atomic",
                SubTitle = "Freeze Trade",
                TabWidth = 160,
                Size = UDim2.fromOffset(580, 460),
                Acrylic = true,
                Theme = "Dark",
            })
            local Tab = Window:AddTab({ Title = "Main", Icon = "home" })
            
            Tab:AddToggle("FreezeTrade", {
                Title = "Activer le Freeze",
                Default = false,
                Callback = function(Value)
                    Config.FreezeEnabled = Value
                    print("Freeze: " .. tostring(Value))
                end,
            })
        end
        
    else
        MsgLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        MsgLabel.Text = "Clé invalide. Réessaie."
    end
end)
