-- ==== 1. Notifications ====
local function notify(title, text, duration)
    duration = duration or 3
    pcall(function()
        StarterGui:SetCore("SendNotification", { Title = title, Text = text, Duration = duration })
    end)
end

local function log(...)
    print("[BossTest]", ...)
end

