                print("[REMOTE FUNCTION] " .. remote.Name .. " appelé avec:", ...)
                return nil
            end
            table.insert(connections, conn)
        end
    end
    -- Hook tous les remotes existants
    local function hookAll(container)
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                hookRemote(child)
            end
            hookAll(child)
        end
    end
    hookAll(ReplicatedStorage)
    task.wait(10)
    for _, conn in ipairs(connections) do
        pcall(conn.Disconnect, conn)
    end
    notify("Remote Listener", "Écoute terminée. Voir console F9.", 3)
end })

