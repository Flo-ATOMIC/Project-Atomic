print("Test des fonctions mobiles...")

if tap then
    print("✅ Fonction 'tap' trouvée !")
    tap(200, 200) -- Clique en haut à gauche
elseif touch then
    print("✅ Fonction 'touch' trouvée !")
    touch(200, 200)
elseif click then
    print("✅ Fonction 'click' trouvée !")
    click(200, 200)
else
    print("❌ Aucune fonction tap/touch/click trouvée.")
end
