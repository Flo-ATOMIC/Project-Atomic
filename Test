-- ==== 5. Fonctions de combat et déplacement ====
local function updatePets()
    local pets = {}
    if LocalPlayer.Character then
        local petsObj = LocalPlayer.Character:FindFirstChild("Pets")
        if petsObj then
            for _, v in ipairs(petsObj:GetChildren()) do
                table.insert(pets, v)
            end
        end
    end
    return pets
end

local function safeAttackEnemy(enemy, pet)
    if CombatRemote and enemy and pet then
        pcall(CombatRemote.InvokeServer, CombatRemote, "AttackEnemy", enemy, pet)
    end
end

local function moveToZone(zoneName)
    local zone = Workspace.Zones:FindFirstChild(zoneName)
    if not zone then return end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local targetPos = zone.Position + Vector3.new(0, 5, 0)
    local tween = TweenService:Create(root, TweenInfo.new(2, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
    tween:Play()
    tween.Completed:Wait()
end

-- ==== 6. FONCTION SPAWN VIA BOSSEVENT ====
local function spawnBossViaEvent(bossName)
    if not config.useBossEvent then return false end
    local remote = findBossEvent()
    if not remote then return false end

    local zoneName = bossZoneMap[bossName]
    if not zoneName then return false end

    local method = config.bossEventMethod
    local argsList = {}

    if method == "auto" or method == "zone" then
        table.insert(argsList, {zoneName})
    end
    if method == "auto" or method == "bossname" then
        table.insert(argsList, {bossName})
    end
    if method == "auto" or method == "both" then
        table.insert(argsList, {zoneName, bossName})
    end
    if method == "auto" or method == "none" then
        table.insert(argsList, {})
    end

    for _, args in ipairs(argsList) do
        local success = false
        if BossEventType == "Function" then
            success = pcall(remote.InvokeServer, remote, table.unpack(args))
        else -- Event
            success = pcall(remote.FireServer, remote, table.unpack(args))
        end
        if success then
            log("BossEvent appelé avec succès pour", bossName, "arguments:", unpack(args))
            return true
        else
            log("Échec de l'appel BossEvent avec", unpack(args))
        end
        task.wait(0.1)
    end
    return false
end

-- Fonction pour appeler BossEvent sur tous les boss activés
local function triggerAllBossEvents()
    if not config.useBossEvent then return end
    for _, bossName in ipairs(bossList) do
        if bossEnabled[bossName] then
            spawnBossViaEvent(bossName)
            task.wait(config.bossAttackDelay)
        end
    end
end

-- ==== 7. AUTO-KILL ====
local function autoKillBosses()
    if not config.autoKillBosses then return end
    local pets = updatePets()
    if #pets == 0 then return end

    for _, bossName in ipairs(bossList) do
        if bossEnabled[bossName] then
            local zone = Workspace.Zones:FindFirstChild(bossZoneMap[bossName])
            if zone then
                if config.autoMoveToZones then
                    pcall(moveToZone, zone.Name)
                end
                local enemies = zone:FindFirstChild("Enemies")
                if enemies then
                    local boss = enemies:FindFirstChild(bossName)
                    if boss and CombatRemote then
                        for _, pet in ipairs(pets) do
                            pcall(CombatRemote.InvokeServer, CombatRemote, "AttackEnemy", boss, pet)
                        end
                        task.wait(0.01)
                    end
                end
            end
        end
    end
end

-- ==== 8. Attaque normale des boss ====
local function attackBosses()
    if not config.farmBosses then return end
    local pets = updatePets()
    if #pets == 0 then return end
    for _, bossName in ipairs(bossList) do
        if bossEnabled[bossName] then
            local zone = Workspace.Zones:FindFirstChild(bossZoneMap[bossName])
            if zone then
                local enemies = zone:FindFirstChild("Enemies")
                if enemies then
                    local boss = enemies:FindFirstChild(bossName)
                    if boss then
                        safeAttackEnemy(boss, pets[1])
                        task.wait(config.bossAttackDelay)
                    end
                end
            end
        end
    end
end

