-- Anti-kick (simplifié)
local AntiKickEnabled = true
local kickAvoidCount = 0
local ac1
local function disableAntiKick()
    AntiKickEnabled = false
    if ac1 then
        hookmetamethod(game, "__namecall", ac1)
        ac1 = nil
    end
end
ac1 = hookmetamethod(game, "__namecall", function(self, ...)
    if not AntiKickEnabled then return ac1(self, ...) end
    local method = getnamecallmethod()
    if method:lower() == "kick" and self == game.Players.LocalPlayer then
        kickAvoidCount = kickAvoidCount + 1
        notify("Kick", "Évitée #" .. tostring(kickAvoidCount), 2)
        return
    end
    return ac1(self, ...)
end)

-- ==== 8. Boucle principale ====
local active = false
local mainThread = nil

local function start()
    if active then return end
    active = true
    mainThread = task.spawn(function()
        while active do
            -- Boss spawn booster
            if config.bossSpawnBooster then
                pcall(forceBossSpawn)
            end
            -- Auto-kill
            if config.autoKillBosses then
                pcall(autoKillBosses)
            end
            -- Attaquer les boss
            if config.farmBosses then
                pcall(attackBosses)
            end
            -- Autres tâches (ennemis, nourriture, oeufs) sont volontairement omises ici pour simplifier, mais vous pouvez les ajouter.
            task.wait(config.bossSpawnInterval)
        end
    end)
    notify("Farm", "Démarré !", 2)
end

local function stop()
    active = false
    if mainThread then task.cancel(mainThread); mainThread = nil end
    notify("Farm", "Arrêté.", 2)
end

