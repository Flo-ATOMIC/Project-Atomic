local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- 🎯 LISTE DE TES PETS
local SEARCH_ORDER = {
    "The Ethereal Everia", "The Grand Titan", "Frozen Dragon"
}

print("⏳ Chargement du script...")
task.wait(2) -- Pause pour le processeur

-- On attend que l'interface de trade soit ouverte manuellement
local TradingGui = PlayerGui:WaitForChild("Trading")
print("✅ Interface trouvée !")

task.wait(2)

local TradeFrame = TradingGui.Container.Frame
local SearchBar = TradeFrame.CurInventory.Search:FindFirstChildOfClass("TextBox")

if not SearchBar then
    print("❌ Barre de recherche introuvable.")
    return
end

-- On tape les noms un par un avec de LONGUES pauses
for i, petName in ipairs(SEARCH_ORDER) do
    print("👉 Étape " .. i .. " : Recherche de " .. petName)
    
    -- On tape le nom
    SearchBar:CaptureFocus()
    SearchBar.Text = petName
    SearchBar:ReleaseFocus()
    
    print("⏳ Attends 4 secondes que le jeu charge le pet...")
    task.wait(4) -- Pause TRÈS longue pour le mobile
    
    print("🖱️ À toi de cliquer sur le pet à l'écran !")
    task.wait(4) -- Encore 4 secondes pour que tu cliques manuellement
end

SearchBar:CaptureFocus()
SearchBar.Text = ""
SearchBar:ReleaseFocus()

print("✅ Fin ! Clique sur READY manuellement.")
