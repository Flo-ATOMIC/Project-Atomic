-- [[ CHARGEMENT DE FLUENT ]] --
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

-- [[ CONFIGURATION DE L'API ]] --
-- Laisse l'URL d'exemple pour tester, on la changera à l'étape suivante
local API_URL = "https://ton-site-web.com/api/check_key" 

-- Création de la fenêtre pour la clé
local KeyWindow = Fluent:CreateWindow({
    Title = "Project Atomic - Accès",
    SubTitle = "Système de clé",
    TabWidth = 160,
    Size = UDim2.fromOffset(500, 350), -- Un peu plus grand pour être sûr
    Acrylic = true,
    Theme = "Dark",
})

local KeyTab = KeyWindow:AddTab({ Title = "Authentification", Icon = "key" })

KeyTab:AddParagraph({
    Title = "Système de clé",
    Content = "Veuillez entrer votre clé d'accès ci-dessous pour utiliser le script."
})

-- ✅ LA CORRECTION EST ICI : AddInput au lieu de AddTextbox
local KeyInput = KeyTab:AddInput("KeyInput", {
    Title = "Clé d'accès",
    Description = "Collez votre clé ici",
    Default = "",
    Placeholder = "Ex: ATOMIC-1234-XYZ",
    Numeric = false, -- Ce n'est pas un chiffre uniquement
    Finished = false, -- Ne valide pas automatiquement quand on appuie sur Entrée
    Callback = function(Text)
        _G.UserKey = Text
        print("Clé tapée : " .. Text)
    end
})

KeyTab:AddButton({
    Title = "Valider la clé",
    Description = "Cliquez pour vérifier votre clé",
    Callback = function()
        local key = _G.UserKey
        
        if not key or key == "" then
            Fluent:Notify({ Title = "Erreur", Content = "Veuillez entrer une clé.", Duration = 3 })
            return
        end

        Fluent:Notify({ Title = "Vérification", Content = "Connexion au serveur...", Duration = 3 })

        -- ⚠️ POUR TESTER : On simule une validation si la clé est "TEST"
        if key == "TEST" then
            Fluent:Notify({ Title = "Succès", Content = "Clé de test validée !", Duration = 5 })
            KeyWindow:Destroy()
            -- loadstring(game:HttpGet("URL_DE_TON_SCRIPT_PRINCIPAL"))()
            return
        end

        -- Envoi de la requête au serveur (API)
        local success, response = pcall(function()
            local playerId = game.Players.LocalPlayer.UserId
            -- On utilise game:HttpGet pour appeler notre API
            return game:HttpGet(API_URL .. "?key=" .. key .. "&userid=" .. playerId)
        end)

        if success then
            if response == "VALID" then
                isAuthenticated = true
                KeyWindow:Destroy() -- On ferme la fenêtre
                Fluent:Notify({ Title = "Succès", Content = "Clé validée !", Duration = 5 })
                
                -- On lance le script principal
                -- loadstring(game:HttpGet("URL_DE_TON_SCRIPT_PRINCIPAL"))()
            else
                Fluent:Notify({ Title = "Erreur", Content = "Clé invalide ou déjà utilisée.", Duration = 5 })
            end
        else
            Fluent:Notify({ Title = "Erreur", Content = "Impossible de contacter le serveur.", Duration = 5 })
        end
    end
})
