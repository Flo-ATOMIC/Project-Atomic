-- ============================================================
-- 2. CONFIGURATION DE LA CLÉ ET DU LIEN
-- ============================================================
local VALID_KEY = "ATOMIC-2911" -- 🔑 Change ça si tu veux une autre clé
local SCRIPT_URL = "https://raw.githubusercontent.com/Flo-ATOMIC/Project-Atomic/refs/heads/main/Sunky" -- 🔗 Ton lien GitHub

-- ============================================================
-- 3. LOGIQUE DE VALIDATION ET CHARGEMENT
-- ============================================================
Button.MouseButton1Click:Connect(function()
    local key = TextBox.Text
    MsgLabel.TextColor3 = Color3.fromRGB(255, 255, 50)
    MsgLabel.Text = "Vérification..."
    
    task.wait(1)
    
    if key == VALID_KEY then
        MsgLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
        MsgLabel.Text = "Clé validée ! Chargement du script..."
        task.wait(1)
        ScreenGui:Destroy() -- On ferme l'écran de clé
        
        -- 📥 CHARGEMENT DU SCRIPT DEPUIS GITHUB
        local success, err = pcall(function()
            loadstring(game:HttpGet(SCRIPT_URL))()
        end)
        
        -- Si le script ne charge pas (erreur de lien, pas de connexion, etc.)
        if not success then
            warn("[ProjectAtomic] Erreur de chargement GitHub : " .. tostring(err))
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Erreur",
                Text = "Impossible de charger le script. Vérifie ta connexion ou le lien.",
                Duration = 5
            })
        end
        
    else
        MsgLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        MsgLabel.Text = "Clé invalide. Réessaie."
    end
end)
