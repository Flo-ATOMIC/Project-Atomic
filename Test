local bossZoneMap = {
    Naga = "Zone2B1", ["Lava Monster"] = "Zone5B1", ["Ghost Pirate"] = "Zone8B1", ["Tiki Monster"] = "Zone10B1",
    ["The Frozen Ancient"] = "Zone12B1", ["The Big 100M"] = "Zone12B3",
