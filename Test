function getPets()
    local pets = {}
    if LocalPlayer.Character then
        local petsObj = LocalPlayer.Character:FindFirstChild("Pets")
        if petsObj then
            for _, v in ipairs(petsObj:GetChildren()) do
                table.insert(pets, v)
            end
        end
    end
    return pets
end

