print("Test de getconnections...")
local TradeGui = game.Players.LocalPlayer.PlayerGui:FindFirstChild("Trading")
if TradeGui then
    local readyBtn = TradeGui.Container.Frame:FindFirstChild("Ready")
    if readyBtn then
        if getconnections then
            local conns = getconnections(readyBtn.MouseButton1Click)
            print("Connexions trouvées : " .. tostring(#conns))
            for i, conn in ipairs(conns) do
                print("Connexion " .. i .. " : " .. typeof(conn))
                -- On tente de déclencher le clic de toutes les manières possibles
                pcall(function() conn:Fire() end)
                pcall(function() conn.Fire(conn) end)
            end
            print("Fin du test.")
        else
            print("getconnections n'est pas supporté par ton executor.")
        end
    else
        print("Bouton Ready introuvable. Ouvre le trade !")
    end
else
    print("Interface Trading introuvable.")
end
