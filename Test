-- ==== 5. Fonctions de base (pets, combats) ====
local petCache = {}
local function updatePets()
    local pets = {}
    if LocalPlayer.Character then
        local petsObj = LocalPlayer.Character:FindFirstChild("Pets")
        if petsObj then
            for _, v in ipairs(petsObj:GetChildren()) do
                table.insert(pets, v)
            end
        end
    end
    return pets
end

local function safeAttackEnemy(enemy, pet)
    if CombatRemote and enemy and pet then
        pcall(CombatRemote.InvokeServer, CombatRemote, "AttackEnemy", enemy, pet)
    end
end

local function attackBosses()
    if not config.farmBosses then return end
    local pets = updatePets()
    if #pets == 0 then return end
    for _, bossName in ipairs(bossList) do
        if bossEnabled[bossName] then
            local zone = Workspace.Zones:FindFirstChild(bossZoneMap[bossName])
            if zone then
                local enemies = zone:FindFirstChild("Enemies")
                if enemies then
                    local boss = enemies:FindFirstChild(bossName)
                    if boss then
                        safeAttackEnemy(boss, pets[1])
                        task.wait(config.bossAttackDelay)
                    end
                end
            end
        end
    end
end

-- ==== 6. BOSS SPAWN BOOSTER (avec vérifications) ====
local bossSpawnRemote = nil
local bossSpawnRemoteType = nil

local function findBossRemote()
    if bossSpawnRemote then return bossSpawnRemote end

    local function search(container)
        if not container then return nil end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("RemoteFunction") or child:IsA("RemoteEvent") then
                local name = child.Name:lower()
                if name:find("boss") and name:find("spawn") then
                    return child
                end
            end
            local found = search(child)
            if found then return found end
        end
        return nil
    end

    -- Chercher d'abord dans Remotes, puis dans tout ReplicatedStorage
    local remote = search(Remotes)
    if not remote then
        remote = search(ReplicatedStorage)
    end

    if remote then
        bossSpawnRemote = remote
        bossSpawnRemoteType = remote:IsA("RemoteFunction") and "Function" or "Event"
        log("Remote de spawn trouvé:", remote.Name, "Type:", bossSpawnRemoteType)
        notify("Spawn Remote", remote.Name .. " trouvé !", 3)
    else
        log("Aucun remote de spawn trouvé.")
        notify("Spawn Remote", "Aucun remote trouvé.", 3)
    end
    return remote
end

local function tryInvokeRemote(remote, args)
    if not remote then return false end
    local success = false
    if remote:IsA("RemoteFunction") then
        success = pcall(remote.InvokeServer, remote, table.unpack(args))
    elseif remote:IsA("RemoteEvent") then
        success = pcall(remote.FireServer, remote, table.unpack(args))
    end
    return success
end

function forceBossSpawn()
    if not config.bossSpawnBooster then return end

    local remote = findBossRemote()
    if not remote then
        -- Essayer d'interagir avec des objets (autels)
        for _, bossName in ipairs(bossList) do
            if bossEnabled[bossName] then
                local zone = Workspace.Zones:FindFirstChild(bossZoneMap[bossName])
                if zone then
                    for _, child in ipairs(zone:GetDescendants()) do
                        if child:IsA("BasePart") and (child.Name:lower():find("altar") or child.Name:lower():find("summon")) then
                            local click = child:FindFirstChildOfClass("ClickDetector")
                            if click then
                                pcall(click.Click, click, LocalPlayer)
                            end
                        end
                    end
                end
            end
        end
        return
    end

    local method = config.forceSpawnMethod
    for _, bossName in ipairs(bossList) do
        if bossEnabled[bossName] then
            local zoneName = bossZoneMap[bossName]
            if zoneName then
                local argsList = {}
                if method == "auto" or method == "zone" then
                    table.insert(argsList, {zoneName})
                end
                if method == "auto" or method == "bossname" then
                    table.insert(argsList, {bossName})
                end
                if method == "auto" or method == "both" then
                    table.insert(argsList, {zoneName, bossName})
                end
                if method == "auto" or method == "none" then
                    table.insert(argsList, {})
                end
                for _, args in ipairs(argsList) do
                    local ok = tryInvokeRemote(remote, args)
                    if ok then
                        log("Spawn appelé pour", bossName, "avec", unpack(args))
                        break
                    end
                end
                task.wait(0.1)
            end
        end
    end
end

-- Auto-kill (pour accélérer)
local function autoKillBosses()
    if not config.autoKillBosses then return end
    local pets = updatePets()
    if #pets == 0 then return end
    for _, bossName in ipairs(bossList) do
        if bossEnabled[bossName] then
            local zone = Workspace.Zones:FindFirstChild(bossZoneMap[bossName])
            if zone then
                local enemies = zone:FindFirstChild("Enemies")
                if enemies then
                    local boss = enemies:FindFirstChild(bossName)
                    if boss and CombatRemote then
                        for _ = 1, 5 do
                            pcall(CombatRemote.InvokeServer, CombatRemote, "AttackEnemy", boss, pets[1])
                            task.wait(0.01)
                        end
                    end
                end
            end
        end
    end
end

