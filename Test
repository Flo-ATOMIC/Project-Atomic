-- ==== 1. Notifications ====
local function notify(title, text, duration)
    duration = duration or 3
    pcall(function() StarterGui:SetCore("SendNotification", { Title = title, Text = text, Duration = duration }) end)
end

local function log(...)
    print("[Project-Atomic]", ...)
end

-- ==== 2. Remotes ====
local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
local Functions = Remotes and Remotes:FindFirstChild("Functions")
local Events = Remotes and Remotes:FindFirstChild("Events")

-- Remote principal : BossEvent (supposé dans Events ou Functions)
local BossEvent = nil
local BossEventType = nil

-- On cherche BossEvent partout
local function findBossEvent()
    if BossEvent then return BossEvent end
    local function search(container)
        if not container then return nil end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                if child.Name == "BossEvent" then
                    return child
                end
            end
            local found = search(child)
            if found then return found end
        end
        return nil
    end
    local remote = search(Remotes)
    if not remote then
        remote = search(ReplicatedStorage)
    end
    if remote then
        BossEvent = remote
        BossEventType = remote:IsA("RemoteFunction") and "Function" or "Event"
        log("BossEvent trouvé !", remote.Name, "Type:", BossEventType)
        notify("BossEvent trouvé", "Type: " .. BossEventType, 3)
    else
        log("BossEvent non trouvé !")
    end
    return remote
end

