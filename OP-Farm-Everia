-- 🐾 & ⚔️
-- ============================================================
local function getPets()
    if LocalPlayer.Character then
        local p = LocalPlayer.Character:FindFirstChild("Pets")
        if p then return p:GetChildren() end
    end
    return {}
end

local function attackEnemy(enemy, pet)
    if CombatRemote then
        pcall(function() CombatRemote:InvokeServer("AttackEnemy", enemy, pet) end)
    end
end

-- ============================================================
-- 🚀 SERVER HOP
-- ============================================================
local function findBestServer()
    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local ok, raw = pcall(function() return game:HttpGet(url) end)
    if not ok then return nil end
    
    local okJson, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not okJson or not data or not data.data then return nil end
    
    local candidates = {}
    for _, srv in ipairs(data.data) do
        if srv.id ~= game.JobId and srv.playing < srv.maxPlayers and srv.playing <= MAX_PLAYERS_SERVER then
            table.insert(candidates, srv)
        end
    end
    if #candidates == 0 then
        for _, srv in ipairs(data.data) do
            if srv.id ~= game.JobId and srv.playing < srv.maxPlayers then
                table.insert(candidates, srv)
            end
        end
    end
    table.sort(candidates, function(a, b) return a.playing < b.playing end)
    return candidates[1]
end

local function serverHop()
    if hopInProgress then return end
    hopInProgress = true
    setStatus("🚀 Server hop...")
    
    if queue_on_teleport and SCRIPT_URL ~= "" then
        pcall(function()
            queue_on_teleport("loadstring(game:HttpGet('" .. SCRIPT_URL .. "'))()")
        end)
    end
    
    local target = findBestServer()
    local success = false
    if target then
        success = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, target.id, LocalPlayer)
        end)
    end
    if not success then
        pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
    end
    hopInProgress = false
end

-- ============================================================
-- 🔄 BOUCLE PRINCIPALE
-- ============================================================
task.spawn(function()
    while true do
        task.wait(ATTACK_DELAY)
        if not isFarming then continue end
        
        local zone = Workspace:FindFirstChild("Zones") and Workspace.Zones:FindFirstChild(BOSS_ZONE)
        if not zone then continue end
        local enemies = zone:FindFirstChild("Enemies")
        if not enemies then continue end
        local everia = enemies:FindFirstChild(BOSS_NAME)
        
        local isAlive = false
        if everia and everia.Parent then
            local hum = everia:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health > 0 then isAlive = true end
        end
        
        if isAlive then
            if not bossWasAlive then
                setStatus("⚔️ Attaque en cours")
                bossWasAlive = true
            end
            local pets = getPets()
            for _, pet in ipairs(pets) do
                attackEnemy(everia, pet)
            end
        elseif bossWasAlive then
            bossWasAlive = false
            killCount = killCount + 1
            btn.Text = "EVERIA: ON (Kills: " .. killCount .. ")"
            setStatus("💀 Boss tué, hop dans " .. HOP_DELAY .. "s")
            task.wait(HOP_DELAY)
            if AUTO_HOP then serverHop() end
        else
            setStatus("⏳ En attente du boss")
        end
    end
end)

