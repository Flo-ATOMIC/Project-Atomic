local function EnableSoundRemover()
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("Sound") then
            pcall(function() obj.Volume = 0 end)
        end
    end
    if SoundConnection then SoundConnection:Disconnect() end
    SoundConnection = game.DescendantAdded:Connect(function(obj)
        if RemoveFarmSounds and obj:IsA("Sound") then
            pcall(function() obj.Volume = 0 end)
        end
    end)
end

-- ============================================================
-- BOUCLE PRINCIPALE
-- ============================================================
local active, mainThread, tasks = false, nil, {}

local function addTask(name, func, interval, runNow)
    table.insert(tasks, { name = name, func = func, interval = interval, nextTime = runNow and 0 or os.clock() + interval })
end

local function mainLoop()
    while active do
        local now = os.clock()
        for _, t in ipairs(tasks) do
            if now >= t.nextTime then
                local s, e = pcall(t.func)
                if not s then warn("Task [" .. t.name .. "]:", e) end
                t.nextTime = now + t.interval
            end
        end
        task.wait(0.01)
    end
end

local function start()
    if active then return end
    active = true
    tasks = {}

    if ZonesRF then
        for _, z in ipairs({"Zone12.1","SummerEventZone","WinterEventZone","ElementEventZone1","Zone2","Zone5","Zone9","Zone10","Zone12"}) do
            pcall(ZonesRF.InvokeServer, ZonesRF, "RequestZoneMap", z)
        end
    end

    removeHatchAnimation()
    removeCoinsAnimation()

    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = config.walkSpeed
        if config.doubleJump then
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            if not jumpConnection then
                jumpConnection = humanoid.Jumping:Connect(function()
                    jumpCount = jumpCount + 1
                    if jumpCount >= 2 then humanoid.Jump = true; jumpCount = 0 end
                end)
            end
        end
    end

    scanBosses()
    addTask("bossScan", scanBosses, 5, true)
    addTask("bossAttack", function() if config.farmBosses then attackBosses() end end, 0, false)
    addTask("enemyAttack", function()
        if config.farmEnemies then
            for idx, info in ipairs(enemyZones) do
                if enemyEnabled[idx] then
                    if info.attackAll then attackEnemiesInZone(info.zone, nil, true)
                    else attackEnemiesInZone(info.zone, info.enemy, false) end
                end
            end
        end
    end, config.enemyDelay, false)
    addTask("foodCollect", function() if config.farmFood then collectFood() end end, config.foodDelay, false)

    mainThread = task.spawn(mainLoop)
    WindUI:Notify({ Title = "Farm", Content = "Farm Started!", Duration = 3 })
end

local function stop()
    active = false
    if mainThread then task.cancel(mainThread); mainThread = nil end
    activeBosses = {}
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = 16
        if config.doubleJump and jumpConnection then
            jumpConnection:Disconnect(); jumpConnection = nil
        end
    end
    WindUI:Notify({ Title = "Farm", Content = "Farm Stopped.", Duration = 3 })
end

