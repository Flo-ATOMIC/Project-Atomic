-- ============================================================
-- 🔄 BOUCLE PRINCIPALE
-- ============================================================
task.spawn(function()
    while true do
        task.wait(ATTACK_DELAY)
        if not isFarming then continue end
        
        local zones = Workspace:FindFirstChild("Zones")
        if not zones then continue end
        
        local pets = getPets()
        if #pets == 0 then continue end
        
        local aliveCount = 0
        
        for _, b in ipairs(bosses) do
            local zone = zones:FindFirstChild(b.zone)
            if zone then
                local enemies = zone:FindFirstChild("Enemies")
                if enemies then
                    local boss = enemies:FindFirstChild(b.name)
                    
                    -- Vérif vivant
                    local alive = false
                    if boss and boss.Parent then
                        local hum = boss:FindFirstChildOfClass("Humanoid")
                        if not hum or hum.Health > 0 then
                            alive = true
                        end
                    end
                    
                    local state = bossState[b.name]
                    
                    if alive then
                        aliveCount = aliveCount + 1
                        state.wasAlive = true
                        
                        -- ⚡ Attaque avec TOUS les pets
                        for _, pet in ipairs(pets) do
                            attackEnemy(boss, pet)
                        end
                    elseif state.wasAlive then
                        -- 💀 Boss vient de mourir
                        state.wasAlive = false
                        totalKills = totalKills + 1
                        lastKillTime = os.clock()
                        btn.Text = (isFarming and "ALL BOSS: ON" or "ALL BOSS: OFF") .. " (Kills: " .. totalKills .. ")"
                        print("💀 " .. b.name .. " tué ! (Total: " .. totalKills .. ")")
                    end
                end
            end
        end
        
        setStatus("👹 Vivants: " .. aliveCount .. "/" .. #bosses .. " | Kills: " .. totalKills)
        
        local timeSinceKill = os.clock() - lastKillTime
        
        if aliveCount == 0 then
            if totalKills > 0 and timeSinceKill >= HOP_DELAY then
                print("🚀 Tous les boss morts, hop...")
                serverHop()
            elseif totalKills == 0 and timeSinceKill >= IDLE_HOP_TIMEOUT then
                print("🚀 Aucun boss depuis " .. IDLE_HOP_TIMEOUT .. "s, hop...")
                lastKillTime = os.clock()
                serverHop()
            end
        end
    end
end)

