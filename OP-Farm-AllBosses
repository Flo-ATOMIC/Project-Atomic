local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

-- Nettoyage
if _G.ATOMIC_STOP then pcall(_G.ATOMIC_STOP) end
local shouldRun = true
_G.ATOMIC_STOP = function() shouldRun = false end

local pg = LocalPlayer:FindFirstChild("PlayerGui")
if pg then
    for _, g in ipairs(pg:GetChildren()) do
        if g.Name == "AllBossFarmer" then pcall(function() g:Destroy() end) end
    end
end

task.wait(2)

local bosses = {
    { name = "Naga",                zone = "Zone2B1" },
    { name = "Lava Monster",        zone = "Zone5B1" },
    { name = "Ghost Pirate",        zone = "Zone8B1" },
    { name = "Tiki Monster",        zone = "Zone10B1" },
    { name = "The Frozen Ancient",  zone = "Zone12B1" },
    { name = "The Big 100M",        zone = "Zone12B3" },
    { name = "The Ethereal Everia", zone = "Zone12B2" },
    { name = "Hornet Boss",         zone = "SummerEventZoneB1" },
    { name = "The Ice Serpent",     zone = "WinterEventZoneB1" },
    { name = "Great Sphinx",        zone = "ElementEventZoneB1" },
}

local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
local Functions = Remotes and Remotes:FindFirstChild("Functions")
local CombatRemote = Functions and Functions:FindFirstChild("CombatRF")

local function getPets()
    if LocalPlayer.Character then
        local p = LocalPlayer.Character:FindFirstChild("Pets")
        if p then return p:GetChildren() end
    end
    return {}
end

local function attackEnemy(enemy, pet)
    if CombatRemote then
        pcall(function() CombatRemote:InvokeServer("AttackEnemy", enemy, pet) end)
    end
end

local totalKills = 0
local bossState = {}
for _, b in ipairs(bosses) do bossState[b.name] = { wasAlive = false } end

print("🧪 Test minimal démarré - AUCUN HOP")

task.spawn(function()
    while shouldRun do
        task.wait(0.05)
        local zones = Workspace:FindFirstChild("Zones")
        if not zones then continue end
        local pets = getPets()
        if #pets == 0 then continue end
        
        for _, b in ipairs(bosses) do
            if not shouldRun then break end
            local zone = zones:FindFirstChild(b.zone)
            if zone then
                local enemies = zone:FindFirstChild("Enemies")
                if enemies then
                    local boss = enemies:FindFirstChild(b.name)
                    local alive = false
                    if boss and boss.Parent then
                        local hum = boss:FindFirstChildOfClass("Humanoid")
                        if not hum or hum.Health > 0 then alive = true end
                    end
                    local state = bossState[b.name]
                    if alive then
                        state.wasAlive = true
                        for _, pet in ipairs(pets) do attackEnemy(boss, pet) end
                    elseif state.wasAlive then
                        state.wasAlive = false
                        totalKills = totalKills + 1
                        print("💀 " .. b.name .. " | Total: " .. totalKills)
                    end
                end
            end
        end
    end
end)
