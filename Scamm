-- Charger Rayfield avec gestion d'erreur
local success, Rayfield = pcall(function()
    return loadstring(game:HttpGet("https://raw.githubusercontent.com/shlexware/Rayfield/main/source"))()
end)

if not success or not Rayfield then
    warn("❌ Échec du chargement de Rayfield. Vérifie ton exécutant ou ta connexion.")
    return
end

-- Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local localPlayer = Players.LocalPlayer

-- Variables globales
local isScriptActive = false
local isPlayer1 = false
local tradeTemplate = nil
local offer1, offer2, ready1, ready2 = nil, nil, nil, nil

-- Fonction pour trouver TradeTemplate (chemin personnalisé)
local function findTradeTemplate()
    -- Chemin 1: ReplicatedStorage.SharedModules.Game.TradeUtils.TradingData.Trade.TradeTemplate
    local path = ReplicatedStorage:FindFirstChild("SharedModules", true)
    if path then
        path = path:FindFirstChild("Game", true)
        if path then
            path = path:FindFirstChild("TradeUtils", true)
            if path then
                path = path:FindFirstChild("TradingData", true)
                if path then
                    path = path:FindFirstChild("Trade", true)
                    if path then
                        tradeTemplate = path:FindFirstChild("TradeTemplate")
                        if tradeTemplate then
                            print("✅ TradeTemplate trouvé via SharedModules/Game/TradeUtils/TradingData/Trade/TradeTemplate")
                            return tradeTemplate
                        end
                    end
                end
            end
        end
    end

    -- Chemin 2: ReplicatedStorage.TradeUtils.TradeTemplate
    path = ReplicatedStorage:FindFirstChild("TradeUtils", true)
    if path then
        tradeTemplate = path:FindFirstChild("TradeTemplate")
        if tradeTemplate then
            print("✅ TradeTemplate trouvé via TradeUtils/TradeTemplate")
            return tradeTemplate
        end
    end

    -- Chemin 3: Recherche globale dans ReplicatedStorage
    for _, descendant in ipairs(ReplicatedStorage:GetDescendants()) do
        if descendant.Name == "TradeTemplate" then
            print("✅ TradeTemplate trouvé via recherche globale : " .. descendant:GetFullName())
            return descendant
        end
    end

    warn("❌ TradeTemplate introuvable.")
    return nil
end

-- Fonction pour trouver les Offers et Ready
local function findTradeElements()
    if not tradeTemplate then return false end

    offer1 = tradeTemplate:FindFirstChild("Offer1") or tradeTemplate:FindFirstChild("Player1Offer")
    offer2 = tradeTemplate:FindFirstChild("Offer2") or tradeTemplate:FindFirstChild("Player2Offer")
    ready1 = tradeTemplate:FindFirstChild("Ready1") or tradeTemplate:FindFirstChild("Player1Ready")
    ready2 = tradeTemplate:FindFirstChild("Ready2") or tradeTemplate:FindFirstChild("Player2Ready")

    if not offer1 then warn("❌ Offer1 introuvable.") end
    if not offer2 then warn("❌ Offer2 introuvable.") end
    if not ready1 then warn("❌ Ready1 introuvable.") end
    if not ready2 then warn("❌ Ready2 introuvable.") end

    return offer1 and offer2 and ready1 and ready2
end

-- Fonction pour vider l'offre et cocher Ready
local function clearOfferAndAccept()
    if not isScriptActive then return end

    if isPlayer1 then
        for _, child in ipairs(offer2:GetChildren()) do
            if child:IsA("ImageLabel") or child:IsA("Frame") then
                child:Destroy()
            end
        end
        ready2.Value = true
        print("✅ Offer2 vidé et Ready2 coché !")
    else
        for _, child in ipairs(offer1:GetChildren()) do
            if child:IsA("ImageLabel") or child:IsA("Frame") then
                child:Destroy()
            end
        end
        ready1.Value = true
        print("✅ Offer1 vidé et Ready1 coché !")
    end
end

-- Fonction pour surveiller les Ready
local function monitorReadyValues()
    if not (ready1 and ready2) then return end

    -- Déconnecter les anciens événements
    if ready1.Changed then ready1.Changed:Disconnect() end
    if ready2.Changed then ready2.Changed:Disconnect() end

    ready1.Changed:Connect(function()
        if ready1.Value and not isPlayer1 then
            clearOfferAndAccept()
        end
    end)

    ready2.Changed:Connect(function()
        if ready2.Value and isPlayer1 then
            clearOfferAndAccept()
        end
    end)
end

-- Fonction pour démarrer le script
local function startScript()
    if isScriptActive then return end
    isScriptActive = true

    -- Attendre que TradeTemplate soit chargé
    repeat
        task.wait(1)
        tradeTemplate = findTradeTemplate()
    until tradeTemplate or not isScriptActive

    if not tradeTemplate then
        isScriptActive = false
        return
    end

    -- Attendre que les Offers et Ready soient disponibles
    repeat
        task.wait(1)
    until findTradeElements() or not isScriptActive

    if not findTradeElements() then
        isScriptActive = false
        return
    end

    -- Déterminer si le joueur local est Player1
    -- (À adapter selon la logique de ton jeu)
    isPlayer1 = (localPlayer.Name == tradeTemplate.Parent.Name)

    -- Surveiller les Ready
    monitorReadyValues()
    print("✅ Script activé et en mode détection !")
end

-- Fonction pour arrêter le script
local function stopScript()
    isScriptActive = false
    if ready1 and ready1.Changed then ready1.Changed:Disconnect() end
    if ready2 and ready2.Changed then ready2.Changed:Disconnect() end
    print("❌ Script désactivé.")
end

