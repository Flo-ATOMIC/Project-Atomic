-- Charger Rayfield avec gestion d'erreur
local Rayfield
local urls = {
    "https://raw.githubusercontent.com/shlexware/Rayfield/main/source",
    "https://sirius.menu/rayfield",
    "https://cdn.jsdelivr.net/gh/shlexware/Rayfield@main/source"
}

for _, url in ipairs(urls) do
    local success, result = pcall(function()
        return loadstring(game:HttpGet(url))()
    end)
    if success and result then
        Rayfield = result
        print("✅ Rayfield chargé depuis : " .. url)
        break
    end
end

if not Rayfield then
    warn("❌ Échec du chargement de Rayfield. Toutes les URLs ont échoué.")
    return
end

-- Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local localPlayer = Players.LocalPlayer

-- Variables globales
local isScriptActive = false
local isPlayer1 = false
local tradeTemplate = nil
local offer1, offer2, ready1, ready2 = nil, nil, nil, nil
local ready1Connection, ready2Connection = nil, nil

-- Fonction pour trouver TradeTemplate
local function findTradeTemplate()
    for _, descendant in ipairs(ReplicatedStorage:GetDescendants()) do
        if descendant.Name == "TradeTemplate" then
            print("✅ TradeTemplate trouvé : " .. descendant:GetFullName())
            return descendant
        end
    end
    warn("❌ TradeTemplate introuvable.")
    return nil
end

-- Fonction pour trouver les Offers et Ready
local function findTradeElements()
    if not tradeTemplate then return false end

    offer1 = tradeTemplate:FindFirstChild("Offer1") or tradeTemplate:FindFirstChild("Player1Offer")
    offer2 = tradeTemplate:FindFirstChild("Offer2") or tradeTemplate:FindFirstChild("Player2Offer")
    ready1 = tradeTemplate:FindFirstChild("Ready1") or tradeTemplate:FindFirstChild("Player1Ready")
    ready2 = tradeTemplate:FindFirstChild("Ready2") or tradeTemplate:FindFirstChild("Player2Ready")

    if not offer1 then warn("❌ Offer1 introuvable.") end
    if not offer2 then warn("❌ Offer2 introuvable.") end
    if not ready1 then warn("❌ Ready1 introuvable.") end
    if not ready2 then warn("❌ Ready2 introuvable.") end

    return offer1 and offer2 and ready1 and ready2
end

-- Fonction pour vider l'offre et cocher Ready
local function clearOfferAndAccept()
    if not isScriptActive then return end

    -- Vérifier que les objets existent
    if isPlayer1 and offer2 and ready2 then
        for _, child in ipairs(offer2:GetChildren()) do
            if child:IsA("ImageLabel") or child:IsA("Frame") then
                child:Destroy()
            end
        end
        ready2.Value = true
        print("✅ Offer2 vidé et Ready2 coché !")
    elseif not isPlayer1 and offer1 and ready1 then
        for _, child in ipairs(offer1:GetChildren()) do
            if child:IsA("ImageLabel") or child:IsA("Frame") then
                child:Destroy()
            end
        end
        ready1.Value = true
        print("✅ Offer1 vidé et Ready1 coché !")
    else
        warn("❌ Impossible de vider l'offre : objets manquants.")
    end
end

-- Fonction pour surveiller les Ready
local function monitorReadyValues()
    -- Déconnecter les anciens événements
    if ready1Connection then ready1Connection:Disconnect() end
    if ready2Connection then ready2Connection:Disconnect() end

    if ready1 and ready2 then
        ready1Connection = ready1.Changed:Connect(function()
            if ready1.Value and not isPlayer1 then
                clearOfferAndAccept()
            end
        end)

        ready2Connection = ready2.Changed:Connect(function()
            if ready2.Value and isPlayer1 then
                clearOfferAndAccept()
            end
        end)
    end
end

-- Fonction pour démarrer le script
local function startScript()
    if isScriptActive then return end
    isScriptActive = true

    -- Attendre que TradeTemplate soit chargé
    repeat
        task.wait(1)
        tradeTemplate = findTradeTemplate()
    until tradeTemplate or not isScriptActive

    if not tradeTemplate then
        isScriptActive = false
        return
    end

    -- Attendre que les Offers et Ready soient disponibles
    repeat
        task.wait(1)
    until findTradeElements() or not isScriptActive

    if not findTradeElements() then
        isScriptActive = false
        return
    end

    -- Déterminer si le joueur local est Player1
    isPlayer1 = (localPlayer.Name == tradeTemplate.Parent.Name)

    -- Surveiller les Ready
    monitorReadyValues()
    print("✅ Script activé et en mode détection !")
end

-- Fonction pour arrêter le script
local function stopScript()
    isScriptActive = false
    if ready1Connection then ready1Connection:Disconnect() end
    if ready2Connection then ready2Connection:Disconnect() end
    print("❌ Script désactivé.")
end

-- Créer l'interface Rayfield
local Window = Rayfield:CreateWindow({
    Name = "Auto Trade Accept",
    LoadingTitle = "Chargement...",
    LoadingSubtitle = "par Florent Flo_RPMX",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "FlorentGoku1234",
        FileName = "AutoTradeConfig"
    },
    Discord = {
        Enabled = false,
    },
    KeySystem = false,
})

-- Onglet principal
local MainTab = Window:CreateTab("Auto Trade", nil)
local MainSection = MainTab:CreateSection("Contrôle du script")

-- Bouton pour activer/désactiver (avec gestion d'erreur)
local ToggleButton = MainTab:CreateButton({
    Name = "Activer/Désactiver le script",
    Callback = function()
        pcall(function()
            if isScriptActive then
                stopScript()
                ToggleButton:Set("Activer le script")
            else
                startScript()
                ToggleButton:Set("Désactiver le script")
            end
        end)
    end,
})

-- Onglet de statut
local StatusTab = Window:CreateTab("Statut", nil)
local StatusSection = StatusTab:CreateSection("État du script")

local StatusLabel = StatusTab:CreateLabel({
    Name = "Statut : Inactif",
    Text = "Statut : ❌ Inactif"
})

-- Mettre à jour le statut (avec gestion d'erreur)
coroutine.wrap(function()
    while true do
        pcall(function()
            StatusLabel:Set("Statut : " .. (isScriptActive and "✅ Actif" or "❌ Inactif"))
        end)
        task.wait(0.5)
    end
end)()

-- Démarrer automatiquement au lancement
pcall(startScript)
if isScriptActive then
    ToggleButton:Set("Désactiver le script")
end

print("✅ Script chargé avec Rayfield !")
