-- Attendre que le jeu soit chargé
repeat wait() until game:IsLoaded()

-- Références
local players = game:GetService("Players")
local localPlayer = players.LocalPlayer
local replicatedStorage = game:GetService("ReplicatedStorage")

-- Attendre que le GUI soit chargé
local gui
repeat
    wait(1)
    gui = localPlayer:FindFirstChild("PlayerGui")
until gui

-- Chercher le bouton READY dans le GUI
local readyButton
for _, child in ipairs(gui:GetDescendants()) do
    if child:IsA("TextButton") and (child.Name == "READY" or child.Text:lower() == "ready") then
        readyButton = child
        break
    end
end

if not readyButton then
    warn("Bouton READY non trouvé !")
    return
end

-- Attendre que TradeTemplate soit chargé
local tradeTemplate = replicatedStorage:WaitForChild("SharedModules"):WaitForChild("Game"):WaitForChild("TradeUtils"):WaitForChild("TradingData"):WaitForChild("Trade"):WaitForChild("TradeTemplate")
local offer1 = tradeTemplate:WaitForChild("Offer1")
local offer2 = tradeTemplate:WaitForChild("Offer2")

-- Fonction pour cliquer sur READY
local function clickReady()
    -- Simuler un clic
    local oldPosition = readyButton.Position
    readyButton.Position = readyButton.Position + UDim2.new(0, 1, 0, 0) -- Déclencher MouseEnter
    wait(0.1)
    readyButton.Position = oldPosition
    readyButton.MouseButton1Click:Fire() -- Déclencher le clic

    -- Supprimer le contenu de l'Offer de l'autre joueur
    if localPlayer.Name == "Flo_S4CR" then
        for _, child in ipairs(offer2:GetChildren()) do
            if child:IsA("ImageLabel") or child:IsA("Frame") then
                child:Destroy()
            end
        end
    else
        for _, child in ipairs(offer1:GetChildren()) do
            if child:IsA("ImageLabel") or child:IsA("Frame") then
                child:Destroy()
            end
        end
    end
end

-- Exécuter après un délai
wait(1)
clickReady()
