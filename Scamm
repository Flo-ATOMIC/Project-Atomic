local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local localPlayer = players.LocalPlayer

-- Attendre que TradeTemplate soit chargé
local tradeTemplate
repeat
    task.wait(1)
    tradeTemplate = replicatedStorage:FindFirstChild("SharedModules", true)
    if tradeTemplate then
        tradeTemplate = tradeTemplate:FindFirstChild("Game", true)
        if tradeTemplate then
            tradeTemplate = tradeTemplate:FindFirstChild("TradeUtils", true)
            if tradeTemplate then
                tradeTemplate = tradeTemplate:FindFirstChild("TradingData", true)
                if tradeTemplate then
                    tradeTemplate = tradeTemplate:FindFirstChild("Trade", true)
                    if tradeTemplate then
                        tradeTemplate = tradeTemplate:FindFirstChild("TradeTemplate")
                    end
                end
            end
        end
    end
until tradeTemplate

-- Références aux Offers et ReadyValues
local offer1 = tradeTemplate:WaitForChild("Offer1")
local offer2 = tradeTemplate:WaitForChild("Offer2")
local ready1 = tradeTemplate:WaitForChild("Ready1")
local ready2 = tradeTemplate:WaitForChild("Ready2")

-- Fonction pour vider l'Offer et cocher Ready
local function autoAcceptTrade()
    -- Déterminer si le joueur local est le joueur 1 ou 2
    -- (On suppose que le joueur 1 est celui qui a ouvert le trade)
    local isPlayer1 = true -- À adapter selon ta logique

    if isPlayer1 then
        -- Vider Offer2 et cocher Ready2
        for _, child in ipairs(offer2:GetChildren()) do
            if child:IsA("ImageLabel") or child:IsA("Frame") then
                child:Destroy()
            end
        end
        ready2.Value = true
        print("✅ Offer2 vidé et Ready2 coché !")
    else
        -- Vider Offer1 et cocher Ready1
        for _, child in ipairs(offer1:GetChildren()) do
            if child:IsA("ImageLabel") or child:IsA("Frame") then
                child:Destroy()
            end
        end
        ready1.Value = true
        print("✅ Offer1 vidé et Ready1 coché !")
    end
end

-- Attendre que le GUI soit chargé
local gui = localPlayer:WaitForChild("PlayerGui")
local tradeFrame
repeat
    task.wait(1)
    tradeFrame = gui:FindFirstChild("TradeFrame") or gui:FindFirstChildOfClass("Frame")
until tradeFrame

-- Chercher le bouton READY
local readyButton
for _, child in ipairs(tradeFrame:GetDescendants()) do
    if child:IsA("TextButton") and (child.Name == "READY" or string.lower(child.Text) == "ready") then
        readyButton = child
        break
    end
end

if readyButton then
    -- Simuler un clic sur READY
    readyButton.MouseButton1Click:Connect(function()
        autoAcceptTrade()
    end)
    print("✅ Bouton READY trouvé ! Le script est prêt.")
else
    warn("❌ Bouton READY non trouvé. Vérifie le nom du bouton dans le GUI.")
end
