-- ============================================================

local function scanBosses()

    if not config.farmBosses then

        activeBosses = {}

        return

    end


    local new = {}


    for _, name in ipairs(bossList) do

        if bossEnabled[name] then

            local zone =
                Workspace.Zones:FindFirstChild(
                    bossZoneMap[name]
                )


            if zone then

                local enemies =
                    zone:FindFirstChild(
                        "Enemies"
                    )


                if enemies then

                    local enemy =
                        enemies:FindFirstChild(
                            name
                        )


                    if enemy then

                        table.insert(
                            new,
                            enemy
                        )

                    end

                end

            end

        end

    end


    activeBosses = new

end


