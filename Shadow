                    table.insert(
                        eggsSelected,
                        egg.zone
                    )

                end

            else

                local idx =
                    table.find(
                        eggsSelected,
                        egg.zone
                    )


                if idx then

                    table.remove(
                        eggsSelected,
                        idx
                    )

                end

            end

        end

    })

end


