-- ============================================================
-- ENEMY ATTACK
-- ============================================================

local function safeAttackEnemy(enemy, pet)

    if not CombatRemote then
        return
    end

    -- Passe par la queue
    queueRequest(
        CombatRemote,
        "InvokeServer",
        "AttackEnemy",
        enemy,
        pet
    )

    requestWorker()

end


-- ============================================================
-- FOOD
-- ============================================================

local function safeCollectFood(food, pet)

    if not CollectionRemote then
        return
    end

    queueRequest(
        CollectionRemote,
        "InvokeServer",
        "CollectFood",
        food,
        pet
    )

    requestWorker()

end


local function attackEnemiesInZone(
    zoneName,
    specificEnemy,
    attackAll
)

    local zone = zoneCache[zoneName]

    if not zone then
        return
    end

    local enemiesObj = zone:FindFirstChild("Enemies")

    if not enemiesObj then
        return
    end

    local enemies

    if attackAll then

        enemies = enemiesObj:GetChildren()

    else

        local enemy = enemiesObj:FindFirstChild(
            specificEnemy
        )

        enemies = enemy and {enemy} or {}

    end

    if #enemies == 0 then
        return
    end

    local pets = updatePets()

    if #pets == 0 then
        return
    end


    if attackAll then

        for i = 1, math.min(#pets, #enemies) do

            safeAttackEnemy(
                enemies[i],
                pets[i]
            )

        end

    else

        for _, pet in ipairs(pets) do

            safeAttackEnemy(
                enemies[1],
                pet
            )

        end

    end

end


-- ============================================================
-- BOSSES
-- ============================================================

local function attackBosses()

    if #activeBosses == 0 then
        return
    end

    local pets = updatePets()

    if #pets == 0 then
        return
    end

    for _, boss in ipairs(activeBosses) do

        if boss and boss.Parent then

            safeAttackEnemy(
                boss,
                pets[1]
            )

        end

    end

end


-- ============================================================
-- FOOD COLLECT
-- ============================================================

local function collectFood()

    for _, fz in ipairs(foodZones) do

        if fz.enabled then

            local zone = zoneCache[fz.zone]

            if zone then

                local foodSpawns = zone:FindFirstChild(
                    "FoodSpawns"
                )

                if foodSpawns then

                    local foods = foodSpawns:GetChildren()

                    if #foods > 0 then

                        local pets = updatePets()

                        if #pets > 0 then

                            for fi, food in ipairs(foods) do

                                local pet =
                                    pets[((fi - 1) % #pets) + 1]

                                safeCollectFood(
                                    food,
                                    pet
                                )

                            end

                        end

                    end

                end

            end

        end

    end

end


