local DEFAULT_BG = "rbxassetid://130707247063445"

local bgState = {
    imageId = nil,
    imageTransparency = 0.2,
    darken = 0.4,
}

local function findWindowFrame()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local ok, main = pcall(function() return Window and Window.Main end)
    if ok and typeof(main) == "Instance" and main:IsDescendantOf(pg) then
        return main
    end
    for _, gui in ipairs(pg:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "RobloxGui" then
            local title = gui:FindFirstChild("Project-Atomic", true)
            if title then
                local f = title
                local topFrame = nil
                while f and f ~= gui do
                    if f:IsA("Frame") then topFrame = f end
                    f = f.Parent
                end
                if topFrame then return topFrame end
            end
        end
    end
    return nil
end

local function clearBackground()
    local parent = findWindowFrame()
    if not parent then return end
    for _, n in ipairs({"CustomBG", "CustomBGOverlay"}) do
        local old = parent:FindFirstChild(n)
        if old then old:Destroy() end
    end
    parent.BackgroundTransparency = 0
    bgState.imageId = nil
end

local function applyBackground(imageId)
    local parent = findWindowFrame()
    if not parent then warn("[BG] Frame Fluent introuvable"); return end
    for _, n in ipairs({"CustomBG", "CustomBGOverlay"}) do
        local old = parent:FindFirstChild(n)
        if old then old:Destroy() end
    end
    if not imageId or imageId == "" then
        parent.BackgroundTransparency = 0
        bgState.imageId = nil
        return
    end
    bgState.imageId = imageId
    parent.BackgroundTransparency = 1
    local parentCorner = parent:FindFirstChildOfClass("UICorner")
    local radius = parentCorner and parentCorner.CornerRadius or UDim.new(0, 8)

    local bg = Instance.new("ImageLabel")
    bg.Name = "CustomBG"
    bg.Size = UDim2.fromScale(1, 1)
    bg.Position = UDim2.fromScale(0, 0)
    bg.BackgroundTransparency = 1
    bg.BorderSizePixel = 0
    bg.Image = imageId
    bg.ImageTransparency = bgState.imageTransparency
    bg.ScaleType = Enum.ScaleType.Crop
    bg.ZIndex = -1
    bg.Parent = parent

    local bgCorner = Instance.new("UICorner")
    bgCorner.CornerRadius = radius
    bgCorner.Parent = bg

    local ov = Instance.new("Frame")
    ov.Name = "CustomBGOverlay"
    ov.Size = UDim2.fromScale(1, 1)
    ov.Position = UDim2.fromScale(0, 0)
    ov.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    ov.BackgroundTransparency = bgState.darken
    ov.BorderSizePixel = 0
    ov.ZIndex = 0
    ov.Parent = parent

    local ovCorner = Instance.new("UICorner")
    ovCorner.CornerRadius = radius
    ovCorner.Parent = ov
end

local function testImage(imageId)
    local pg = LocalPlayer:WaitForChild("PlayerGui")
    local old = pg:FindFirstChild("_AtomicBGTest")
    if old then old:Destroy() end
    local test = Instance.new("ScreenGui")
    test.Name = "_AtomicBGTest"
    test.DisplayOrder = 999
    test.IgnoreGuiInset = true
    test.Parent = pg
    local img = Instance.new("ImageLabel")
    img.Size = UDim2.fromScale(1, 1)
    img.BackgroundTransparency = 1
    img.Image = imageId
    img.ScaleType = Enum.ScaleType.Crop
    img.Parent = test
    Fluent:Notify({ Title = "Test Image", Content = "Affichage 3s de l'ID...", Duration = 3 })
    task.delay(3, function() if test then test:Destroy() end end)
end

