-- ============================================================
-- PHYSICAL EGG DESTROYER
-- ============================================================

local physicalEggDestroyerRunning = false

local physicalEggConnection = nil


local function getPodiumPads()

    local nests = Workspace:FindFirstChild(
        "Nests"
    )

    if not nests then

        warn(
            "[Physical Eggs] Nests introuvable dans Workspace"
        )

        return nil

    end


    -- Cherche PodiumPads dans tous les descendants
    local podiumPads =
        nests:FindFirstChild(
            "PodiumPads",
            true
        )


    if not podiumPads then

        warn(
            "[Physical Eggs] PodiumPads introuvable dans Nests"
        )

        return nil

    end


    return podiumPads

end


local function isPhysicalEgg(obj)

    if not obj:IsA("Model") then
        return false
    end

    if obj.Name ~= "Egg" then
        return false
    end


    local pad = obj.Parent

    if not pad then
        return false
    end


    local padNumber = tonumber(
        pad.Name
    )


    if not padNumber then
        return false
    end


    if padNumber < 1 or padNumber > 9 then
        return false
    end


    local podiumPads = pad.Parent

    if not podiumPads then
        return false
    end


    if podiumPads.Name ~= "PodiumPads" then
        return false
    end


    return true

end


local function destroyExistingPhysicalEggs()

    local podiumPads = getPodiumPads()

    if not podiumPads then
        return
    end


    for i = 1, 9 do

        local pad = podiumPads:FindFirstChild(
            tostring(i)
        )


        if pad then

            local egg = pad:FindFirstChild(
                "Egg"
            )


            if egg and egg:IsA("Model") then

                egg:Destroy()

                print(
                    "[Physical Eggs] Egg détruit sur le pad "
                    .. i
                )

            end

        end

    end

end


local function startPhysicalEggDestroyer()

    if physicalEggDestroyerRunning then
        return
    end


    physicalEggDestroyerRunning = true


    -- Supprime ceux qui existent déjà
    destroyExistingPhysicalEggs()


    -- Surveille les nouveaux Eggs
    physicalEggConnection =
        Workspace.DescendantAdded:Connect(
            function(obj)

                if not physicalEggDestroyerRunning then
                    return
                end


                if isPhysicalEgg(obj) then

                    task.defer(function()

                        if obj and obj.Parent then

                            obj:Destroy()

                            print(
                                "[Physical Eggs] Nouvel Egg détruit"
                            )

                        end

                    end)

                end

            end
        )


    print(
        "[Physical Eggs] Destroyer activé"
    )

end


local function stopPhysicalEggDestroyer()

    physicalEggDestroyerRunning = false


    if physicalEggConnection then

        physicalEggConnection:Disconnect()

        physicalEggConnection = nil

    end


    print(
        "[Physical Eggs] Destroyer désactivé"
    )

end


local function setPhysicalEggDestroyer(enabled)

    if enabled then

        startPhysicalEggDestroyer()

    else

        stopPhysicalEggDestroyer()

    end

end


