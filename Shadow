-- ============================================================
-- TASK SYSTEM
-- ============================================================

local function addTask(
    name,
    func,
    interval
)

    table.insert(
        tasks,
        {
            name = name,
            func = func,
            interval = interval,
            nextTime = 0
        }
    )

end


local function mainLoop()

    while active do

        local now = os.clock()


        for _, taskInfo in ipairs(tasks) do

            if now >= taskInfo.nextTime then

                local success, err =
                    pcall(
                        taskInfo.func
                    )


                if not success then

                    warn(
                        "Task error:",
                        err
                    )

                end


                taskInfo.nextTime =
                    now + taskInfo.interval

            end

        end


        -- Vérification raisonnable
        task.wait(0.05)

    end

end


-- ============================================================
-- START FARMING
-- ============================================================

local function start()

    if active then
        return
    end


    active = true

    tasks = {}


    -- Pré-charger les zones
    if ZonesRF then

        pcall(
            ZonesRF.InvokeServer,
            ZonesRF,
            "RequestZoneMap",
            "Zone12.1"
        )

        pcall(
            ZonesRF.InvokeServer,
            ZonesRF,
            "RequestZoneMap",
            "SummerEventZone"
        )

        pcall(
            ZonesRF.InvokeServer,
            ZonesRF,
            "RequestZoneMap",
            "WinterEventZone"
        )

        pcall(
            ZonesRF.InvokeServer,
            ZonesRF,
            "RequestZoneMap",
            "ElementEventZone1"
        )

    end


    scanBosses()


    -- Boss scan
    addTask(
        "bossScan",
        scanBosses,
        10
    )


    -- Boss attack
    addTask(
        "bossAttack",
        function()

            if config.farmBosses
                and #activeBosses > 0 then

                attackBosses()

            end

        end,
        0.5
    )


    -- Enemies
    addTask(
        "enemyAttack",
        function()

            if config.farmEnemies then

                for idx, zoneInfo
                    in ipairs(enemyZones) do

                    if enemyEnabled[idx] then

                        if zoneInfo.attackAll then

                            attackEnemiesInZone(
                                zoneInfo.zone,
                                nil,
                                true
                            )

                        else

                            attackEnemiesInZone(
                                zoneInfo.zone,
                                zoneInfo.enemy,
                                false
                            )

                        end

                    end

                end

            end

        end,
        config.enemyDelay
    )


    -- Food
    addTask(
        "foodCollect",
        function()

            if config.farmFood then
                collectFood()
            end

        end,
        config.foodDelay
    )


    -- Plant
    addTask(
        "plant",
        doPlanting,
        config.eggDelay
    )


    -- Hatch
    addTask(
        "hatch",
        doHatching,
        config.eggDelay
    )


    -- Nests
    addTask(
        "nests",
        doNests,
        config.eggDelay
    )


    mainThread =
        task.spawn(mainLoop)


    Rayfield:Notify({
        Title = "Project-Atomic",
        Content = "Farm Starting!",
        Duration = 3
    })

end


-- ============================================================
-- STOP FARMING
-- ============================================================

local function stop()

    active = false


    if mainThread then

        task.cancel(mainThread)

        mainThread = nil

    end


    activeBosses = {}

    -- Vide la file d'attente
    requestQueue = {}


    Rayfield:Notify({
        Title = "Project-Atomic",
        Content = "Farm Ended.",
        Duration = 2
    })

end


