-- ============================================================
-- PET CACHE
-- ============================================================

local petCache = {}
local nestCache = nil

local lastPetUpdate = 0
local lastNestUpdate = 0

local PET_UPDATE_INTERVAL = 1.0
local NEST_UPDATE_INTERVAL = 30


local function updatePets()
    local now = os.clock()

    if now - lastPetUpdate > PET_UPDATE_INTERVAL then

        if LocalPlayer.Character then

            local petsObj = LocalPlayer.Character:FindFirstChild("Pets")

            if petsObj then

                local pets = petsObj:GetChildren()

                for i, v in ipairs(pets) do
                    petCache[i] = v
                end

                for i = #pets + 1, #petCache do
                    petCache[i] = nil
                end

            else

                for i = 1, #petCache do
                    petCache[i] = nil
                end

            end

        else

            for i = 1, #petCache do
                petCache[i] = nil
            end

        end

        lastPetUpdate = now
    end

    return petCache
end


local function updateNests()

    local now = os.clock()

    if now - lastNestUpdate > NEST_UPDATE_INTERVAL then

        nestCache = Workspace:FindFirstChild("Nests")

        lastNestUpdate = now

    end

    return nestCache
end


-- ============================================================
-- REQUEST QUEUE / ANTI SPAM
-- ============================================================

local requestQueue = {}
local queueRunning = false

-- Nombre maximum de requêtes envoyées par seconde
local MAX_REQUESTS_PER_SECOND = 5000

-- Taille maximum de la file
local MAX_QUEUE_SIZE = 500


local function queueRequest(remote, method, ...)

    if not remote then
        return
    end

    -- Évite de faire grossir la file indéfiniment
    if #requestQueue >= MAX_QUEUE_SIZE then
        return
    end

    table.insert(requestQueue, {
        remote = remote,
        method = method,
        args = {...}
    })

end


local function requestWorker()

    if queueRunning then
        return
    end

    queueRunning = true

    task.spawn(function()

        local interval = 1 / MAX_REQUESTS_PER_SECOND

        while #requestQueue > 0 do

            local request = table.remove(requestQueue, 1)

            if request and request.remote then

                pcall(function()

                    if request.method == "FireServer" then

                        request.remote:FireServer(
                            table.unpack(request.args)
                        )

                    elseif request.method == "InvokeServer" then

                        request.remote:InvokeServer(
                            table.unpack(request.args)
                        )

                    end

                end)

            end

            task.wait(interval)

        end

        queueRunning = false

    end)

end


