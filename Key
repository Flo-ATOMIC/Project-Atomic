-- ============================================================
-- LOGIQUE DU BOUTON
-- ============================================================
Btn.MouseButton1Click:Connect(function()
    local key = TextBox.Text
    
    if key == "" then
        Msg.TextColor3 = Color3.fromRGB(255, 50, 50)
        Msg.Text = "Veuillez entrer une clé."
        return
    end

    Msg.TextColor3 = Color3.fromRGB(255, 255, 50)
    Msg.Text = "Vérification en cours..."
    Btn.Active = false
    Btn.Text = "Chargement..."

    -- On encode la clé pour éviter les bugs si tu as mis un espace
    local safeKey = HttpService:UrlEncode(key)
    local requestUrl = API_URL .. "?key=" .. safeKey .. "&userid=" .. tostring(player.UserId)
    
    -- Appel de notre fonction robuste
    local success, response = MakeRequest(requestUrl)

    if success and response then
        print("[Debug KeySystem] Réponse du serveur :", response) -- Utile pour voir dans la console (F9)
        
        -- On vérifie si la réponse contient "VALID"
        if string.find(response, "VALID") then
            Msg.TextColor3 = Color3.fromRGB(0, 255, 0)
            Msg.Text = "Clé validée ! Chargement du menu..."
            task.wait(1)
            KeyGui:Destroy()
            
            -- Chargement du menu WindUI
            local loadSuccess, loadErr = pcall(function()
                loadstring(game:HttpGet(SCRIPT_URL))()
            end)
            
            if not loadSuccess then
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "Erreur",
                    Text = "Impossible de charger le menu : " .. tostring(loadErr),
                    Duration = 5
                })
            end
        else
            Msg.TextColor3 = Color3.fromRGB(255, 50, 50)
            Msg.Text = "Clé invalide ou déjà liée à un autre compte."
            Btn.Active = true
            Btn.Text = "Valider la clé"
        end
    else
        Msg.TextColor3 = Color3.fromRGB(255, 50, 50)
        Msg.Text = "Erreur réseau (Vérifie la console F9)."
        Btn.Active = true
        Btn.Text = "Valider la clé"
        warn("[KeySystem] Erreur de requête : " .. tostring(response))
    end
end)
