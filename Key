-- ============================================================
-- FONCTION DE REQUÊTE ROBUSTE (HttpGet + Timeout)
-- ============================================================
local function MakeRequest(url)
    local result = { success = false, body = nil }
    
    -- On lance game:HttpGet dans un thread séparé
    local thread = task.spawn(function()
        local ok, res = pcall(function()
            return game:HttpGet(url)
        end)
        if ok and res then
            result.success = true
            result.body = res
        end
    end)

    -- On attend maximum 10 secondes
    local timer = 0
    while timer < 10 and not result.success do
        task.wait(0.1)
        timer = timer + 0.1
    end

    -- Si c'est trop long, on annule la requête
    if not result.success then
        pcall(function() task.cancel(thread) end)
    end

    return result.success, result.body
end

-- ============================================================
-- LOGIQUE DU BOUTON
-- ============================================================
Btn.MouseButton1Click:Connect(function()
    local key = TextBox.Text
    
    if key == "" then
        Msg.TextColor3 = Color3.fromRGB(255, 50, 50)
        Msg.Text = "Veuillez entrer une clé."
        return
    end

    Msg.TextColor3 = Color3.fromRGB(255, 255, 50)
    Msg.Text = "Vérification en cours..."
    Btn.Active = false
    Btn.Text = "Chargement..."

    local safeKey = HttpService:UrlEncode(key)
    local requestUrl = API_URL .. "?key=" .. safeKey .. "&userid=" .. tostring(player.UserId)
    
    -- Appel de la requête
    local success, response = MakeRequest(requestUrl)

    if success and response then
        print("[KeySystem] Réponse serveur :", response)
        
        -- Si la réponse contient VALID
        if string.find(response, "VALID") then
            Msg.TextColor3 = Color3.fromRGB(0, 255, 0)
            Msg.Text = "Clé validée ! Chargement du menu..."
            task.wait(1)
            KeyGui:Destroy()
            
            local loadSuccess, loadErr = pcall(function()
                loadstring(game:HttpGet(SCRIPT_URL))()
            end)
            
            if not loadSuccess then
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "Erreur",
                    Text = "Impossible de charger le menu.",
                    Duration = 5
                })
            end
        else
            Msg.TextColor3 = Color3.fromRGB(255, 50, 50)
            Msg.Text = "Clé invalide ou déjà utilisée."
            Btn.Active = true
            Btn.Text = "Valider la clé"
        end
    else
        Msg.TextColor3 = Color3.fromRGB(255, 50, 50)
        Msg.Text = "Erreur de délai (Timeout)."
        Btn.Active = true
        Btn.Text = "Valider la clé"
        warn("[KeySystem] La requête a pris trop de temps ou a été bloquée.")
    end
end)
