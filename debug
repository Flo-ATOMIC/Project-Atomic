-- Anti-kick
local AntiKickEnabled = true
local kickAvoidCount = 0
local ac1
local function disableAntiKick()
    AntiKickEnabled = false
    if ac1 then
        hookmetamethod(game, "__namecall", ac1)
        ac1 = nil
    end
end
ac1 = hookmetamethod(game, "__namecall", function(self, ...)
    if not AntiKickEnabled then return ac1(self, ...) end
    local method = getnamecallmethod()
    if method:lower() == "kick" and self == game.Players.LocalPlayer then
        kickAvoidCount = kickAvoidCount + 1
        notify("Kick", "Évitée #" .. tostring(kickAvoidCount), 2)
        return
    end
    return ac1(self, ...)
end)

-- ==== 10. Boucle principale ====
local active = false
local mainThread = nil

local function start()
    if active then return end
    active = true
    mainThread = task.spawn(function()
        local spawnIndex = 1
        while active do
            -- SPAWN DES BOSS (tourne en boucle sur tous les boss)
            if config.autoSpawnBosses then
                local bossName = bossList[spawnIndex]
                if bossName and bossEnabled[bossName] then
                    pcall(spawnBoss, bossName)
                end
                spawnIndex = spawnIndex + 1
                if spawnIndex > #bossList then
                    spawnIndex = 1
                end
                task.wait(config.spawnInterval)
            end
            
            -- AUTO-KILL
            if config.autoKillBosses then
                pcall(autoKillBosses)
            end
            
            -- FARM BOSSES
            if config.farmBosses then
                pcall(attackBosses)
            end
            
            -- HATCH & NESTS
            pcall(doHatching)
            pcall(doNests)
            
            task.wait(0.05)
        end
    end)
    notify("Farm", "Démarré !", 2)
end

local function stop()
    active = false
    if mainThread then task.cancel(mainThread); mainThread = nil end
    notify("Farm", "Arrêté.", 2)
end

