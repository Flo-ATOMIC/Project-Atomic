local function teleportToModel(model)
	local character, humanoidRootPart = getCharacter()
	if not humanoidRootPart or not humanoidRootPart.Parent then
		return false
	end

	-- 👇 on cherche "Handle" (sans s), avec fallback
	local targetPart = model.PrimaryPart
		or model:FindFirstChild("Handle")
		or model:FindFirstChildWhichIsA("BasePart", true)

	if not targetPart then
		warn("[AutoBackpackTeleport] Aucune part pour se téléporter dans : " .. model:GetFullName())
		return false
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.PlatformStand = true
	end

	local targetCFrame = CFrame.new(targetPart.Position + TELEPORT_OFFSET, targetPart.Position)
	humanoidRootPart.CFrame = targetCFrame

	task.wait(0.35)

	if humanoid then
		humanoid.PlatformStand = false
	end

	return true
end

local function interactWithBackpack(model)
	-- 👇 "Handle" au singulier
	local handle = model:FindFirstChild("Handle")
	if not handle then
		warn("[AutoBackpackTeleport] 'Handle' introuvable dans : " .. model:GetFullName())
		return false
	end

	local prompt = handle:FindFirstChild("SearchBackpack")
	if not prompt then
		warn("[AutoBackpackTeleport] 'SearchBackpack' introuvable dans : " .. handle:GetFullName())
		return false
	end

	if not prompt:IsA("ProximityPrompt") then
		warn("[AutoBackpackTeleport] 'SearchBackpack' n'est pas un ProximityPrompt.")
		return false
	end

	if not prompt.Enabled then
		warn("[AutoBackpackTeleport] Prompt désactivé.")
		return false
	end

	-- Appel direct = équivalent à appuyer sur E
	local okBegin, err = pcall(function() prompt:InputHoldBegin() end)
	if not okBegin then
		warn("[AutoBackpackTeleport] InputHoldBegin a échoué : " .. tostring(err))
		return false
	end

	task.wait((prompt.HoldDuration or 0.5) + 0.2)

	local okEnd, errEnd = pcall(function() prompt:InputHoldEnd() end)
	if not okEnd then
		warn("[AutoBackpackTeleport] InputHoldEnd a échoué : " .. tostring(errEnd))
		return false
	end

	print("[AutoBackpackTeleport] Prompt déclenché ✅ sur " .. model:GetFullName())
	return true
end
