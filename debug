-- ==== 6. Tests automatiques ====
local function runTests()
    notify("Diagnostic", "Lancement des tests...", 3)
    log("=== DÉBUT DES TESTS ===")

    -- Test 1 : ZonesRF avec "RequestZoneMap"
    if ZonesRF then
        for _, bossName in ipairs(bossList) do
            local zoneName = bossZoneMap[bossName]
            log("🔹 Test ZonesRF RequestZoneMap pour", zoneName)
            callRemote(ZonesRF, {"RequestZoneMap", zoneName}, true)
            task.wait(0.5)
        end
    end

    -- Test 2 : ZonesRE avec zone seule
    if ZonesRE then
        for _, bossName in ipairs(bossList) do
            local zoneName = bossZoneMap[bossName]
            log("🔹 Test ZonesRE avec", zoneName)
            callRemote(ZonesRE, {zoneName}, false)
            task.wait(0.5)
        end
    end

    -- Test 3 : BossesEvent avec zone seule
    if BossesEvent then
        for _, bossName in ipairs(bossList) do
            local zoneName = bossZoneMap[bossName]
            log("🔹 Test BossesEvent avec", zoneName)
            callRemote(BossesEvent, {zoneName}, false)
            task.wait(0.5)
        end
    end

    -- Test 4 : BossesEvent avec zone + boss
    if BossesEvent then
        for _, bossName in ipairs(bossList) do
            local zoneName = bossZoneMap[bossName]
            log("🔹 Test BossesEvent avec", zoneName, bossName)
            callRemote(BossesEvent, {zoneName, bossName}, false)
            task.wait(0.5)
        end
    end

    -- Test 5 : BossesEvent avec "Spawn" + zone
    if BossesEvent then
        for _, bossName in ipairs(bossList) do
            local zoneName = bossZoneMap[bossName]
            log("🔹 Test BossesEvent avec 'Spawn'", zoneName)
            callRemote(BossesEvent, {"Spawn", zoneName}, false)
            task.wait(0.5)
        end
    end

    -- Test 6 : RequestData si disponible
    if RequestData then
        log("🔹 Test RequestData")
        callRemote(RequestData, {}, false)
        task.wait(0.5)
    end

    log("=== TESTS TERMINÉS ===")
    notify("Diagnostic", "Tests terminés. Voir console F9 pour les détails.", 4)
end

