-- Petit outil supplémentaire : écouter les événements pour voir si BossEvent est utilisé
local bossRemote = nil
for _, r in ipairs(allRemotes) do
    if r.name == "BossEvent" then
        bossRemote = r.ref
        break
    end
end

if bossRemote then
    print("\n=== BossEvent trouvé ! ===")
    print("Nom :", bossRemote.Name)
    print("Type :", bossRemote.ClassName)
    print("Chemin :", bossRemote:GetFullName())
    
    -- Si c'est un RemoteEvent, on peut écouter les appels
    if bossRemote:IsA("RemoteEvent") then
        local conn = bossRemote.OnServerEvent:Connect(function(player, ...)
            print("[BOSS EVENT] Appel reçu de", player.Name, "avec arguments :", ...)
        end)
        print("Écoute de BossEvent activée. Déclenchez un boss manuellement pour voir les arguments.")
        task.wait(15) -- écoute pendant 15 secondes
        conn:Disconnect()
        print("Écoute terminée.")
    else
        -- RemoteFunction : on peut essayer de hook OnServerInvoke (mais attention, cela peut bloquer)
        print("C'est un RemoteFunction. Pour voir les arguments, il faudrait modifier le script du jeu.")
    end
else
    print("Aucun remote nommé 'BossEvent' trouvé.")
end

