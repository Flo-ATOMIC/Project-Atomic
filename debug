-- ==== 5. Fonctions de base ====
local function updatePets()
    local pets = {}
    if LocalPlayer.Character then
        local petsObj = LocalPlayer.Character:FindFirstChild("Pets")
        if petsObj then
            for _, v in ipairs(petsObj:GetChildren()) do
                table.insert(pets, v)
            end
        end
    end
    return pets
end

local function safeAttackEnemy(enemy, pet)
    if CombatRF and enemy and pet then
        pcall(CombatRF.InvokeServer, CombatRF, "AttackEnemy", enemy, pet)
    end
end

-- Déplacement vers une zone
local function moveToZone(zoneName)
    local zone = Workspace.Zones:FindFirstChild(zoneName)
    if not zone then return end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local targetPos = zone.Position + Vector3.new(0, 5, 0)
    local tween = TweenService:Create(root, TweenInfo.new(2, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
    tween:Play()
    tween.Completed:Wait()
end

-- ==== 6. FONCTION DE SPAWN DES BOSS (toutes les combinaisons) ====
local function spawnBoss(bossName)
    if not config.autoSpawnBosses then return end
    if not bossEnabled[bossName] then return end
    
    local zoneName = bossZoneMap[bossName]
    if not zoneName then return end
    
    -- Méthode 1: BossesEvent avec zone
    if BossesEvent then
        pcall(BossesEvent.FireServer, BossesEvent, zoneName)
        task.wait(0.1)
        pcall(BossesEvent.FireServer, BossesEvent, bossName)
        task.wait(0.1)
        pcall(BossesEvent.FireServer, BossesEvent, zoneName, bossName)
        task.wait(0.1)
        pcall(BossesEvent.FireServer, BossesEvent, "Spawn", zoneName)
        task.wait(0.1)
        pcall(BossesEvent.FireServer, BossesEvent, "Spawn", bossName)
        task.wait(0.1)
        pcall(BossesEvent.FireServer, BossesEvent, {zoneName})
        task.wait(0.1)
        pcall(BossesEvent.FireServer, BossesEvent, {bossName})
        task.wait(0.1)
    end
    
    -- Méthode 2: ZonesRE
    if ZonesRE then
        pcall(ZonesRE.FireServer, ZonesRE, zoneName)
        task.wait(0.1)
        pcall(ZonesRE.FireServer, ZonesRE, bossName)
        task.wait(0.1)
        pcall(ZonesRE.FireServer, ZonesRE, zoneName, bossName)
        task.wait(0.1)
    end
    
    -- Méthode 3: ZonesRF (RequestZoneMap)
    if ZonesRF then
        pcall(ZonesRF.InvokeServer, ZonesRF, "RequestZoneMap", zoneName)
        task.wait(0.1)
        pcall(ZonesRF.InvokeServer, ZonesRF, zoneName)
        task.wait(0.1)
    end
    
    -- Méthode 4: Si déplacement automatique, on se rend dans la zone
    if config.autoMoveToZones then
        pcall(moveToZone, zoneName)
    end
end

-- ==== 7. AUTO-KILL (ultra rapide) ====
local function autoKillBosses()
    if not config.autoKillBosses then return end
    local pets = updatePets()
    if #pets == 0 then return end

    for _, bossName in ipairs(bossList) do
        if bossEnabled[bossName] then
            local zone = Workspace.Zones:FindFirstChild(bossZoneMap[bossName])
            if zone then
                local enemies = zone:FindFirstChild("Enemies")
                if enemies then
                    local boss = enemies:FindFirstChild(bossName)
                    if boss and CombatRF then
                        -- Attaque en rafale avec tous les pets
                        for _, pet in ipairs(pets) do
                            pcall(CombatRF.InvokeServer, CombatRF, "AttackEnemy", boss, pet)
                        end
                        task.wait(0.01)
                    end
                end
            end
        end
    end
end

-- ==== 8. Attaque normale des boss (si farm activé) ====
local function attackBosses()
    if not config.farmBosses then return end
    local pets = updatePets()
    if #pets == 0 then return end
    for _, bossName in ipairs(bossList) do
        if bossEnabled[bossName] then
            local zone = Workspace.Zones:FindFirstChild(bossZoneMap[bossName])
            if zone then
                local enemies = zone:FindFirstChild("Enemies")
                if enemies then
                    local boss = enemies:FindFirstChild(bossName)
                    if boss then
                        safeAttackEnemy(boss, pets[1])
                        task.wait(config.bossAttackDelay)
                    end
                end
            end
        end
    end
end

