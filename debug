-- ==== 1. Notifications ====
local function notify(title, text, duration)
    duration = duration or 3
    pcall(function() StarterGui:SetCore("SendNotification", { Title = title, Text = text, Duration = duration }) end)
end

-- ==== 2. Remotes ====
local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
local Functions = Remotes and Remotes:FindFirstChild("Functions")
local CombatRF = Functions and Functions:FindFirstChild("CombatRF")
local ZonesRF = Functions and Functions:FindFirstChild("ZonesRF")

print("[Auto-Kill] CombatRF:", CombatRF ~= nil)
print("[Auto-Kill] ZonesRF:", ZonesRF ~= nil)

-- ==== 3. Données des boss ====
local bossZoneMap = {
    Naga = "Zone2B1", 
    ["Lava Monster"] = "Zone5B1", 
    ["Ghost Pirate"] = "Zone8B1", 
    ["Tiki Monster"] = "Zone10B1",
    ["The Frozen Ancient"] = "Zone12B1", 
    ["The Big 100M"] = "Zone12B3",
    ["The Ethereal Everia"] = "Zone12B2", 
    ["Hornet Boss"] = "SummerEventZoneB1",
    ["The Ice Serpent"] = "WinterEventZoneB1", 
    ["Great Sphinx"] = "ElementEventZoneB1",
}
local bossList = {
    "Naga", "Lava Monster", "Ghost Pirate", "Tiki Monster", "The Frozen Ancient", "The Big 100M",
    "The Ethereal Everia", "Hornet Boss", "The Ice Serpent", "Great Sphinx"
}
local bossEnabled = {}
for _, name in ipairs(bossList) do bossEnabled[name] = true end

-- Cache des zones pour éviter de recréer les références
local zoneCache = {}
local function getZone(zoneName)
    if not zoneCache[zoneName] then
        zoneCache[zoneName] = Workspace.Zones:FindFirstChild(zoneName)
    end
    return zoneCache[zoneName]
end

-- ==== 4. Configuration ====
local config = {
    autoKill = false,
    autoMove = false,
    wakeZones = false,
    killSpeed = 0.001,
    moveInterval = 0.1,
    wallspeed = 50,
}

-- ==== 5. Fonctions ====
local function getPets()
    local pets = {}
    if LocalPlayer.Character then
        local petsObj = LocalPlayer.Character:FindFirstChild("Pets")
        if petsObj then
            for _, v in ipairs(petsObj:GetChildren()) do
                table.insert(pets, v)
            end
        end
    end
    return pets
end

-- Téléportation instantanée
local function teleportToZone(zoneName)
    local zone = getZone(zoneName)
    if not zone then return false end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local targetPos = zone.Position + Vector3.new(0, 10, 0)
    root.CFrame = CFrame.new(targetPos)
    return true
end

-- Attaque ultra-rapide d'un boss
local function killBoss(boss, pets)
    if not CombatRF or not boss then return false end
    local killed = false
    for _, pet in ipairs(pets) do
        for i = 1, 3 do
            local success = pcall(CombatRF.InvokeServer, CombatRF, "AttackEnemy", boss, pet)
            if success then killed = true end
        end
    end
    return killed
end

-- Réveil des zones
local function wakeUpZones()
    if not config.wakeZones or not ZonesRF then return end
    for _, bossName in ipairs(bossList) do
        if bossEnabled[bossName] then
            local zoneName = bossZoneMap[bossName]
            if zoneName then
                pcall(ZonesRF.InvokeServer, ZonesRF, "RequestZoneMap", zoneName)
            end
        end
    end
end

-- ==== 6. Boucle principale (optimisée avec RunService) ====
local active = false
local mainThread = nil
local moveIndex = 1
local wakeTimer = 0
local killCounter = 0

local function farmLoop()
    if not active then return end
    
    local pets = getPets()
    if #pets == 0 then 
        task.wait(0.1)
        return 
    end
    
    -- Réveil des zones (toutes les 2 secondes)
    if config.wakeZones then
        wakeTimer = wakeTimer + 0.05
        if wakeTimer >= 2 then
            wakeTimer = 0
            pcall(wakeUpZones)
        end
    end
    
    -- Parcours des boss
    local killedThisCycle = 0
    for _, bossName in ipairs(bossList) do
        if bossEnabled[bossName] then
            local zoneName = bossZoneMap[bossName]
            local zone = getZone(zoneName)
            if zone then
                -- Téléportation dans la zone (si activé)
                if config.autoMove then
                    pcall(teleportToZone, zoneName)
                end
                
                local enemies = zone:FindFirstChild("Enemies")
                if enemies then
                    local boss = enemies:FindFirstChild(bossName)
                    if boss then
                        local killed = pcall(killBoss, boss, pets)
                        if killed then
                            killedThisCycle = killedThisCycle + 1
                            killCounter = killCounter + 1
                        end
                        task.wait(config.killSpeed)
                    end
                end
            end
        end
    end
    
    -- Notification périodique
    if killCounter > 0 and killCounter % 10 == 0 then
        notify("Auto-Kill", "Total: " .. killCounter .. " boss tués", 1)
    end
    
    -- Petite pause pour ne pas surcharger
    task.wait(0.02)
end

local function start()
    if active then return end
    if not CombatRF then
        notify("Erreur", "CombatRF introuvable !", 3)
        return
    end
    active = true
    killCounter = 0
    wakeTimer = 0
    mainThread = RunService.Heartbeat:Connect(farmLoop)
    notify("Auto-Kill", "Démarré !", 2)
end

local function stop()
    active = false
    if mainThread then 
        mainThread:Disconnect() 
        mainThread = nil 
    end
    notify("Auto-Kill", "Arrêté.", 2)
end

