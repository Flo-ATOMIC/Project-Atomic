-- ==== 5. Fonctions de base ====
local function getPets()
    local pets = {}
    if LocalPlayer.Character then
        local petsObj = LocalPlayer.Character:FindFirstChild("Pets")
        if petsObj then
            for _, v in ipairs(petsObj:GetChildren()) do
                table.insert(pets, v)
            end
        end
    end
    return pets
end

local function getZone(zoneName)
    if not zoneCache[zoneName] then
        zoneCache[zoneName] = Workspace.Zones:FindFirstChild(zoneName)
    end
    return zoneCache[zoneName]
end

local function teleportToZone(zoneName)
    local zone = getZone(zoneName)
    if not zone then return false end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    root.CFrame = CFrame.new(zone.Position + Vector3.new(0, 10, 0))
    return true
end

-- ==== 6. AUTO-KILL ====
local function killBoss(boss, pets)
    if not CombatRF or not boss then return false end
    for _, pet in ipairs(pets) do
        for i = 1, 3 do
            pcall(CombatRF.InvokeServer, CombatRF, "AttackEnemy", boss, pet)
        end
    end
    return true
end

local function autoKill()
    if not config.autoKill then return end
    local pets = getPets()
    if #pets == 0 then return end
    
    for _, bossName in ipairs(bossList) do
        if bossEnabled[bossName] then
            local zone = getZone(bossZoneMap[bossName])
            if zone then
                if config.autoMove then
                    pcall(teleportToZone, bossZoneMap[bossName])
                end
                local enemies = zone:FindFirstChild("Enemies")
                if enemies then
                    local boss = enemies:FindFirstChild(bossName)
                    if boss then
                        pcall(killBoss, boss, pets)
                        task.wait(config.killSpeed)
                    end
                end
            end
        end
    end
end

-- ==== 7. RÉVEIL DES ZONES ====
local wakeTimer = 0
local function wakeUpZones()
    if not config.wakeZones or not ZonesRF then return end
    wakeTimer = wakeTimer + 0.05
    if wakeTimer >= 2 then
        wakeTimer = 0
        for _, bossName in ipairs(bossList) do
            if bossEnabled[bossName] then
                local zoneName = bossZoneMap[bossName]
                if zoneName then
                    pcall(ZonesRF.InvokeServer, ZonesRF, "RequestZoneMap", zoneName)
                end
            end
        end
    end
end

-- ==== 8. AUTO-HATCH (ultra rapide) ====
local function autoHatch()
    if not config.autoHatch or not HatchEggEvent then return end
    -- Appel en rafale pour éclore plusieurs oeufs rapidement
    for i = 1, 10 do
        pcall(HatchEggEvent.FireServer, HatchEggEvent)
    end
end

-- ==== 9. AUTO-PLANT (ultra rapide) ====
local function autoPlant()
    if not config.autoPlant or not PlantEggEvent then return end
    for zoneName, enabled in pairs(eggsSelected) do
        if enabled then
            -- Plantation en rafale
            for i = 1, 10 do
                pcall(PlantEggEvent.FireServer, PlantEggEvent, zoneName)
            end
            task.wait(config.eggSpeed)
        end
    end
end

-- ==== 10. AUTO-NESTS (ultra rapide) ====
local function autoNests()
    if not config.autoNests or not FeedEggEvent then return end
    
    -- Mise à jour du cache des nids (toutes les 30s)
    local now = os.clock()
    if now - lastNestUpdate > 30 then
        nestCache = Workspace:FindFirstChild("Nests")
        lastNestUpdate = now
    end
    
    if nestCache then
        for _, nest in ipairs(nestCache:GetChildren()) do
            for i = 1, 5 do
                pcall(FeedEggEvent.FireServer, FeedEggEvent, nest)
            end
            task.wait(config.nestSpeed)
        end
    end
end

-- ==== 11. DOUBLE SAUT ====
local jumpConnection, jumpCount
local function setupDoubleJump()
    if config.doubleJump then
        local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            jumpCount = 0
            if not jumpConnection then
                jumpConnection = humanoid.Jumping:Connect(function()
                    jumpCount = jumpCount + 1
                    if jumpCount >= 2 then
                        humanoid.Jump = true
                        jumpCount = 0
                    end
                end)
            end
        end
    elseif jumpConnection then
        jumpConnection:Disconnect()
        jumpConnection = nil
        jumpCount = 0
    end
end

-- ==== 12. VITESSE ====
local function setSpeed()
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = config.wallspeed
    end
end

-- ==== 13. ANTI-KICK ====
local AntiKickEnabled = true
local kickAvoidCount = 0
local ac1

local function disableAntiKick()
    AntiKickEnabled = false
    if ac1 then
        hookmetamethod(game, "__namecall", ac1)
        ac1 = nil
    end
end

ac1 = hookmetamethod(game, "__namecall", function(self, ...)
    if not AntiKickEnabled then return ac1(self, ...) end
    local method = getnamecallmethod()
    if method:lower() == "kick" and self == game.Players.LocalPlayer then
        kickAvoidCount = kickAvoidCount + 1
        notify("Kick", "Évitée #" .. tostring(kickAvoidCount), 2)
        return
    end
    return ac1(self, ...)
end)

-- ==== 14. BOUCLE PRINCIPALE ====
local active = false
local mainConnection = nil
local killCounter = 0

local function farmLoop()
    if not active then return end
    
    -- Réveil des zones
    pcall(wakeUpZones)
    
    -- Auto-Kill
    pcall(autoKill)
    
    -- Auto-Hatch
    pcall(autoHatch)
    
    -- Auto-Plant
    pcall(autoPlant)
    
    -- Auto-Nests
    pcall(autoNests)
    
    -- Vitesse (maintien)
    pcall(setSpeed)
    
    task.wait(0.01) -- Ultra rapide
end

local function start()
    if active then return end
    if not CombatRF then
        notify("Erreur", "CombatRF introuvable !", 3)
        return
    end
    active = true
    killCounter = 0
    wakeTimer = 0
    
    -- Setup double jump
    pcall(setupDoubleJump)
    
    -- Démarrer la boucle
    mainConnection = RunService.Heartbeat:Connect(farmLoop)
    notify("Project-Atomic", "Farm démarré !", 2)
end

local function stop()
    active = false
    if mainConnection then
        mainConnection:Disconnect()
        mainConnection = nil
    end
    notify("Project-Atomic", "Farm arrêté.", 2)
end

