local function debugPrompt(prompt)
	print("---- Prompt debug ----")
	print("Nom       :", prompt:GetFullName())
	print("Enabled   :", prompt.Enabled)
	print("Distance  :", prompt.MaxActivationDistance)
	print("HoldDur   :", prompt.HoldDuration)
	print("LineOfSight:", prompt.RequiresLineOfSight)
	print("ObjectText:", prompt.ObjectText)
	print("ActionText:", prompt.ActionText)
	print("KeyboardKeyCode:", prompt.KeyboardKeyCode)
	print("----------------------")
end

local function tryTriggerPrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") then return false end
	if not prompt.Enabled then
		warn("Prompt désactivé.")
		return false
	end

	-- Vérif distance
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	local targetPart = prompt.Parent
	if hrp and targetPart and targetPart:IsA("BasePart") then
		local dist = (hrp.Position - targetPart.Position).Magnitude
		print(string.format("[AutoBackpack] Distance au prompt : %.2f studs (max %d)",
			dist, prompt.MaxActivationDistance))
		if dist > prompt.MaxActivationDistance then
			warn("Trop loin — je me rapproche d'abord.")
			hrp.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 0, 2))
			task.wait(0.4)
		end
	end

	debugPrompt(prompt)

	-- Appel direct : c'est CE QUE FAIT LA TOUCHE E en interne
	local okBegin, errBegin = pcall(function()
		prompt:InputHoldBegin()
	end)
	if not okBegin then
		warn("InputHoldBegin a échoué : " .. tostring(errBegin))
		return false
	end

	print("Hold commencé, attente de", prompt.HoldDuration, "s")
	task.wait((prompt.HoldDuration or 0.5) + 0.3)

	local okEnd, errEnd = pcall(function()
		prompt:InputHoldEnd()
	end)
	if not okEnd then
		warn("InputHoldEnd a échoué : " .. tostring(errEnd))
		return false
	end

	print("Prompt déclenché ✅")
	return true
end
