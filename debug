-- ==== 4. Fonction d'appel de remote ====
local function callRemote(remote, args, isFunction)
    if not remote then
        notify("Erreur", "Remote introuvable", 2)
        return false
    end
    local success, result
    if isFunction then
        success, result = pcall(remote.InvokeServer, remote, table.unpack(args))
    else
        success, result = pcall(remote.FireServer, remote, table.unpack(args))
    end
    if success then
        log("Appel réussi sur", remote.Name, "avec arguments:", table.unpack(args))
        notify("Succès", remote.Name .. " appelé avec " .. #args .. " argument(s)", 2)
    else
        log("Erreur sur", remote.Name, ":", result)
        notify("Erreur", remote.Name .. " : " .. tostring(result), 3)
    end
    return success
end

