-- ==== 4. Fonction pour appeler un remote et logger ====
local function callRemote(remote, args, isFunction)
    if not remote then
        log("Remote introuvable")
        return false
    end
    local success, result
    if isFunction then
        success, result = pcall(remote.InvokeServer, remote, table.unpack(args))
    else
        success, result = pcall(remote.FireServer, remote, table.unpack(args))
    end
    if success then
        log("✅ SUCCÈS sur", remote.Name, "args:", table.unpack(args))
        if result then
            log("   Réponse du serveur:", result)
        end
    else
        log("❌ ÉCHEC sur", remote.Name, "Erreur:", result)
    end
    return success
end

