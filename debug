-- ==== 7. SCAN DE WORKSPACE POUR INTERACTIONS (DÉTAILLÉ) ====
local altarObjects = {}

local function scanWorkspaceForAltars()
    altarObjects = {}
    log("=== SCAN DE WORKSPACE POUR INTERACTIONS ===")
    for _, bossName in ipairs(bossList) do
        local zoneName = bossZoneMap[bossName]
        local zone = Workspace.Zones:FindFirstChild(zoneName)
        if zone then
            for _, child in ipairs(zone:GetDescendants()) do
                if child:IsA("ClickDetector") then
                    local parent = child.Parent
                    if parent and parent:IsA("BasePart") then
                        log("ClickDetector trouvé dans", zoneName, "sur", parent.Name, "(full path:", child:GetFullName(), ")")
                        table.insert(altarObjects, {
                            type = "ClickDetector",
                            detector = child,
                            part = parent,
                            zone = zoneName,
                            boss = bossName
                        })
                    end
                elseif child:IsA("ProximityPrompt") then
                    log("ProximityPrompt trouvé dans", zoneName, "sur", child.Parent and child.Parent.Name or "inconnu", "(full path:", child:GetFullName(), ")")
                    table.insert(altarObjects, {
                        type = "ProximityPrompt",
                        prompt = child,
                        zone = zoneName,
                        boss = bossName
                    })
                end
            end
        end
    end
    log("=== FIN SCAN ===")
    notify("Scan Workspace", #altarObjects .. " interactions trouvées. Voir console F9 pour les détails.", 4)
end

-- ==== 9. CLIC SUR LES AUTELS (amélioré) ====
function clickAllAltars()
    if #altarObjects == 0 then
        scanWorkspaceForAltars()
    end
    for _, obj in ipairs(altarObjects) do
        if obj.type == "ClickDetector" and obj.detector then
            local success, err = pcall(function()
                obj.detector:Click(LocalPlayer)
            end)
            if success then
                log("Clic effectué sur ClickDetector dans", obj.zone, "pour", obj.boss)
            else
                log("Erreur clic sur", obj.zone, ":", err)
            end
        elseif obj.type == "ProximityPrompt" and obj.prompt then
            local success, err = pcall(function()
                -- Essayer différentes méthodes d'activation
                obj.prompt:InputHoldBegin(LocalPlayer)
                task.wait(0.1)
                obj.prompt:InputHoldEnd(LocalPlayer)
            end)
            if success then
                log("Prompt activé dans", obj.zone, "pour", obj.boss)
            else
                log("Erreur prompt sur", obj.zone, ":", err)
            end
        end
        task.wait(0.2)
    end
end

-- Ajouter un bouton pour cliquer uniquement sur un autel spécifique (ex: celui de Naga)
function clickAltarForBoss(bossName)
    local zoneName = bossZoneMap[bossName]
    if not zoneName then return end
    local found = false
    for _, obj in ipairs(altarObjects) do
        if obj.zone == zoneName then
            if obj.type == "ClickDetector" and obj.detector then
                pcall(obj.detector.Click, obj.detector, LocalPlayer)
                log("Clic manuel sur", obj.part and obj.part.Name or "inconnu", "pour", bossName)
                found = true
            elseif obj.type == "ProximityPrompt" and obj.prompt then
                pcall(obj.prompt.InputHoldBegin, obj.prompt, LocalPlayer)
                task.wait(0.1)
                pcall(obj.prompt.InputHoldEnd, obj.prompt, LocalPlayer)
                log("Prompt activé pour", bossName)
                found = true
            end
            break
        end
    end
    if not found then
        notify("Aucun autel", "Pour " .. bossName .. ", scanné ?", 2)
    end
end
