local Events = Remotes and Remotes:FindFirstChild("Events")
local Functions = Remotes and Remotes:FindFirstChild("Functions")

-- Liste des remotes intéressants (on ajoute aussi CombatRF pour les attaques)
local candidateRemotes = {
    { name = "BossesEvent", remote = Events and Events:FindFirstChild("BossesEvent"), type = "Event" },
    { name = "ZonesRE", remote = Events and Events:FindFirstChild("ZonesRE"), type = "Event" },
    { name = "CombatRE", remote = Events and Events:FindFirstChild("CombatRE"), type = "Event" },
    { name = "DamageRE", remote = Events and Events:FindFirstChild("DamageRE"), type = "Event" },
    { name = "CombatRF", remote = Functions and Functions:FindFirstChild("CombatRF"), type = "Function" },
    { name = "ZonesRF", remote = Functions and Functions:FindFirstChild("ZonesRF"), type = "Function" },
}

-- Filtrer ceux qui existent
local availableRemotes = {}
for _, info in ipairs(candidateRemotes) do
    if info.remote then
