-- Script de débogage : Liste tous les remotes dans ReplicatedStorage
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace") -- on peut aussi scanner Workspace au cas où

local function getAllRemotes(container, path)
    path = path or ""
    local remotes = {}
    for _, child in ipairs(container:GetChildren()) do
        local childPath = path .. "/" .. child.Name
        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
            table.insert(remotes, {
                name = child.Name,
                path = childPath,
                class = child.ClassName,
                ref = child
            })
        end
        -- Récursion dans les sous-dossiers
        local sub = getAllRemotes(child, childPath)
        for _, r in ipairs(sub) do
            table.insert(remotes, r)
        end
    end
    return remotes
end

-- Scanner ReplicatedStorage
print("=== SCAN DE REPLICATEDSTORAGE ===")
local allRemotes = getAllRemotes(ReplicatedStorage, "ReplicatedStorage")
for _, r in ipairs(allRemotes) do
    print(r.path, "(" .. r.class .. ")")
end
print("Total remotes trouvés dans ReplicatedStorage : " .. #allRemotes)

