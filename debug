-- ==== 16. BOUCLE PRINCIPALE ====
local active = false
local mainThread = nil
local hatchCounter = 0
local lastHatchNotify = 0

local function mainLoop()
    while active do
        local startTime = os.clock()
        
        -- HATCH ULTRA RAPIDE (exécuté en premier)
        if config.autoHatch then 
            pcall(autoHatch)
            hatchCounter = hatchCounter + (config.hatchCount * config.hatchCycles)
        end
        
        -- Notification toutes les secondes
        local now = os.clock()
        if now - lastHatchNotify >= 1 and hatchCounter > 0 then
            notify("Hatch Speed", hatchCounter .. " oeufs/secondes", 1)
            lastHatchNotify = now
            hatchCounter = 0
        end
        
        -- Réveil des zones
        if config.wakeZones then 
            pcall(wakeUpZones) 
        end
        
        -- Auto-Kill
        if config.autoKill or config.farmBosses then 
            pcall(killBosses) 
        end
        
        -- Auto-Plant
        if config.autoPlant then 
            pcall(autoPlant) 
        end
        
        -- Auto-Nests
        if config.autoNests then 
            pcall(autoNests) 
        end
        
        -- Vitesse
        pcall(setSpeed)
        
        -- Calcul du temps de cycle
        local cycleTime = os.clock() - startTime
        local waitTime = math.max(0.001, 0.02 - cycleTime)
        task.wait(waitTime)
    end
end

local function start()
    if active then return end
    if not CombatRF then
        notify("Erreur", "CombatRF introuvable !", 3)
        return
    end
    active = true
    hatchCounter = 0
    lastHatchNotify = 0
    wakeTimer = 0
    pcall(setupDoubleJump)
    mainThread = task.spawn(mainLoop)
    notify("Project-Atomic", "Farm démarré ! Hatch 1000+/s", 2)
end

local function stop()
    active = false
    if mainThread then task.cancel(mainThread); mainThread = nil end
    notify("Project-Atomic", "Farm arrêté.", 2)
end

