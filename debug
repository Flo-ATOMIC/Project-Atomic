-- ==== 5. Fonctions ====
local function updatePets()
    local pets = {}
    if LocalPlayer.Character then
        local petsObj = LocalPlayer.Character:FindFirstChild("Pets")
        if petsObj then
            for _, v in ipairs(petsObj:GetChildren()) do
                table.insert(pets, v)
            end
        end
    end
    return pets
end

-- Téléportation instantanée vers une zone
local function teleportToZone(zoneName)
    local zone = Workspace.Zones:FindFirstChild(zoneName)
    if not zone then return false end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local targetPos = zone.Position + Vector3.new(0, 10, 0)
    root.CFrame = CFrame.new(targetPos)
    return true
end

-- Attaque en rafale ultra-rapide
local function rapidAttackBoss(boss, pet)
    if not CombatRF or not boss or not pet then return end
    for i = 1, 5 do
        pcall(CombatRF.InvokeServer, CombatRF, "AttackEnemy", boss, pet)
    end
end

-- ==== 6. RÉVEIL DES ZONES (avec toutes les méthodes) ====
local function wakeUpZones()
    if not config.wakeUpZones then return end
    
    for _, bossName in ipairs(bossList) do
        if bossEnabled[bossName] then
            local zoneName = bossZoneMap[bossName]
            if zoneName then
                -- Méthode 1: ZonesRF avec RequestZoneMap
                if ZonesRF then
                    pcall(ZonesRF.InvokeServer, ZonesRF, "RequestZoneMap", zoneName)
                    task.wait(0.05)
                    pcall(ZonesRF.InvokeServer, ZonesRF, "RequestZoneMap", bossName)
                    task.wait(0.05)
                end
                
                -- Méthode 2: BossesEvent
                if BossesEvent then
                    pcall(BossesEvent.FireServer, BossesEvent, zoneName)
                    task.wait(0.05)
                    pcall(BossesEvent.FireServer, BossesEvent, bossName)
                    task.wait(0.05)
                    pcall(BossesEvent.FireServer, BossesEvent, zoneName, bossName)
                    task.wait(0.05)
                end
                
                -- Méthode 3: ZonesRE
                if ZonesRE then
                    pcall(ZonesRE.FireServer, ZonesRE, zoneName)
                    task.wait(0.05)
                    pcall(ZonesRE.FireServer, ZonesRE, bossName)
                    task.wait(0.05)
                end
                
                -- Méthode 4: Téléportation dans la zone
                if config.autoMove then
                    pcall(teleportToZone, zoneName)
                    task.wait(0.05)
                end
            end
        end
    end
end

-- ==== 7. TENTATIVE DE SPAWN DIRECT ====
local function attemptSpawnBosses()
    if not config.spawnAttempt then return end
    
    for _, bossName in ipairs(bossList) do
        if bossEnabled[bossName] then
            local zoneName = bossZoneMap[bossName]
            if zoneName and BossesEvent then
                -- Toutes les combinaisons possibles
                local combos = {
                    {zoneName},
                    {bossName},
                    {zoneName, bossName},
                    {"Spawn", zoneName},
                    {"Spawn", bossName},
                    {"Summon", zoneName},
                    {"Summon", bossName},
                    {"Activate", zoneName},
                    {"Activate", bossName},
                    {zoneName, "Spawn"},
                    {bossName, "Spawn"},
                }
                for _, args in ipairs(combos) do
                    pcall(BossesEvent.FireServer, BossesEvent, table.unpack(args))
                    task.wait(0.02)
                end
                task.wait(0.1)
            end
        end
    end
end

-- ==== 8. AUTO-KILL PRINCIPAL ====
local function killAllBosses()
    if not config.autoKill then return end
    
    local pets = updatePets()
    if #pets == 0 then return end
    
    local killedCount = 0
    
    for _, bossName in ipairs(bossList) do
        if bossEnabled[bossName] then
            local zoneName = bossZoneMap[bossName]
            local zone = Workspace.Zones:FindFirstChild(zoneName)
            if zone then
                -- Si téléportation activée, on se déplace dans la zone
                if config.autoMove then
                    pcall(teleportToZone, zoneName)
                    task.wait(0.02)
                end
                
                local enemies = zone:FindFirstChild("Enemies")
                if enemies then
                    local boss = enemies:FindFirstChild(bossName)
                    if boss then
                        -- Attaque en rafale avec TOUS les pets
                        for _, pet in ipairs(pets) do
                            pcall(rapidAttackBoss, boss, pet)
                        end
                        killedCount = killedCount + 1
                        task.wait(config.killDelay)
                    end
                end
            end
        end
    end
    
    if killedCount > 0 and killedCount % 5 == 0 then
        notify("Auto-Kill", killedCount .. " boss tués cette session", 1)
    end
end

-- ==== 9. Boucle principale ====
local active = false
local mainThread = nil
local wakeTimer = 0

local function start()
    if active then return end
    if not CombatRF then
        notify("Erreur", "CombatRF introuvable !", 3)
        return
    end
    active = true
    mainThread = task.spawn(function()
        while active do
            -- 1. Réveil des zones (toutes les X secondes)
            if config.wakeUpZones then
                pcall(wakeUpZones)
            end
            
            -- 2. Tentative de spawn direct
            if config.spawnAttempt then
                pcall(attemptSpawnBosses)
            end
            
            -- 3. Auto-Kill
            if config.autoKill then
                pcall(killAllBosses)
            end
            
            task.wait(0.01)
        end
    end)
    notify("Auto-Kill", "Démarré !", 2)
end

local function stop()
    active = false
    if mainThread then task.cancel(mainThread); mainThread = nil end
    notify("Auto-Kill", "Arrêté.", 2)
end

