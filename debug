local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local StarterGui = game:GetService("StarterGui")

-- ==== 1. Notifications ====
local function notify(title, text, duration)
    duration = duration or 3
    pcall(function() StarterGui:SetCore("SendNotification", { Title = title, Text = text, Duration = duration }) end)
end

local function log(...)
    print("[Remote Sniffer]", ...)
end

-- ==== 2. Variables de suivi ====
local sniffing = false
local sniffDuration = 30 -- secondes
local connections = {}

-- ==== 3. Fonction pour hook les remotes ====
local function hookRemote(remote, path)
    if remote:IsA("RemoteEvent") then
        local conn = remote.OnServerEvent:Connect(function(player, ...)
            if player == LocalPlayer then
                log("📡 REMOTE EVENT:", path, "arguments:", ...)
            end
        end)
        table.insert(connections, conn)
    elseif remote:IsA("RemoteFunction") then
        -- Pour les fonctions, on ne peut pas hook directement, on va utiliser une métatable pour logger les appels entrants
        -- Mais on peut logger quand on appelle nous-mêmes, pas quand le serveur appelle. 
        -- On va plutôt logger via un wrapper si possible.
        -- On va créer un proxy sur InvokeServer pour logger les appels que NOUS faisons.
        -- Mais pour capturer les appels serveur -> client, ce n'est pas possible.
        -- On peut juste logger les appels que le client fait vers le serveur via InvokeServer.
        local oldInvoke = remote.InvokeServer
        remote.InvokeServer = function(self, ...)
            log("📡 REMOTE FUNCTION (invoke):", path, "arguments:", ...)
            return oldInvoke(self, ...)
        end
        -- On garde aussi l'original pour restaurer après
        table.insert(connections, { restore = function() remote.InvokeServer = oldInvoke end })
    end
end

-- ==== 4. Fonction pour parcourir les remotes ====
local function hookAllRemotes(container, path)
    path = path or container.Name
    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
            hookRemote(child, path .. "/" .. child.Name)
        end
        hookAllRemotes(child, path .. "/" .. child.Name)
    end
end

-- ==== 5. Démarrer l'écoute ====
function startSniffing()
    if sniffing then
        notify("Sniffer", "Déjà en cours", 2)
        return
    end
    sniffing = true
    log("=== DÉBUT DE L'ÉCOUTE (durée: " .. sniffDuration .. "s) ===")
    notify("Sniffer", "Écoute démarrée, déclenchez un boss dans le jeu !", 3)
    
    -- Hook tous les remotes dans ReplicatedStorage
    hookAllRemotes(ReplicatedStorage)
    
    -- Aussi dans Workspace (au cas où)
    hookAllRemotes(Workspace)
    
    -- Arrêter après la durée
    task.wait(sniffDuration)
    stopSniffing()
end

function stopSniffing()
    if not sniffing then return end
    sniffing = false
    log("=== FIN DE L'ÉCOUTE ===")
    -- Restaurer les remotes (pour les fonctions modifiées)
    for _, conn in ipairs(connections) do
        if conn.restore then
            conn.restore()
        else
            pcall(conn.Disconnect, conn)
        end
    end
    connections = {}
    notify("Sniffer", "Écoute terminée. Voir console (F9).", 3)
end

