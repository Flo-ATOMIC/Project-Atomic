local function doHatching()
    if not config.autoHatch or not HatchRemote then return end
    pcall(HatchRemote.FireServer, HatchRemote)
end

local function doNests()
    if not config.autoNests or not FeedRemote then return end
    local nests = Workspace:FindFirstChild("Nests")
    if nests then
        for _, nest in ipairs(nests:GetChildren()) do
            pcall(FeedRemote.FireServer, FeedRemote, nest)
        end
    end
end

local function sacrificePet(petName)
    if SacrificeRemote then
        pcall(SacrificeRemote.InvokeServer, SacrificeRemote, "SacrificeWell", petName)
    end
end

-- Anti-kick
local AntiKickEnabled = true
local kickAvoidCount = 0
local ac1
local function disableAntiKick()
    AntiKickEnabled = false
    if ac1 then
        hookmetamethod(game, "__namecall", ac1)
        ac1 = nil
    end
end
ac1 = hookmetamethod(game, "__namecall", function(self, ...)
    if not AntiKickEnabled then return ac1(self, ...) end
    local method = getnamecallmethod()
    if method:lower() == "kick" and self == game.Players.LocalPlayer then
        kickAvoidCount = kickAvoidCount + 1
        notify("Kick", "Évitée #" .. tostring(kickAvoidCount), 2)
        return
    end
    return ac1(self, ...)
end)

-- ==== 9. Boucle principale ====
local active = false
local mainThread = nil

local function start()
    if active then return end
    active = true
    mainThread = task.spawn(function()
        while active do
            if config.autoKillBosses then
                pcall(autoKillBosses)
            end
            if config.farmBosses then
                pcall(attackBosses)
            end
            pcall(doHatching)
            pcall(doNests)
            -- Autres tâches...
            task.wait(0.1) -- très rapide pour maximiser les kills
        end
    end)
    notify("Farm", "Démarré !", 2)
end

local function stop()
    active = false
    if mainThread then task.cancel(mainThread); mainThread = nil end
    notify("Farm", "Arrêté.", 2)
end

