-- DEBUG: Find SharedModules and TradingUtils anywhere

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local ServerStorage = game:GetService("ServerStorage")

local function printHierarchy(parent, indent)
    indent = indent or ""
    for _, child in ipairs(parent:GetChildren()) do
        print(indent .. child.Name .. " (" .. child.ClassName .. ")")
        if #child:GetChildren() > 0 then
            printHierarchy(child, indent .. "  ")
        end
    end
end

-- Search for a specific name (case‑insensitive) and print its path
local function findDeep(parent, target, path)
    path = path or parent.Name
    for _, child in ipairs(parent:GetChildren()) do
        if string.lower(child.Name) == string.lower(target) then
            warn("✅ FOUND " .. target .. " at: " .. path .. "." .. child.Name)
        end
        if #child:GetChildren() > 0 then
            findDeep(child, target, path .. "." .. child.Name)
        end
    end
end

print("🔍 Scanning ReplicatedStorage...")
findDeep(ReplicatedStorage, "SharedModules")
findDeep(ReplicatedStorage, "TradingUtils")

print("🔍 Scanning Workspace...")
findDeep(Workspace, "SharedModules")
findDeep(Workspace, "TradingUtils")

print("🔍 Scanning ServerStorage...")
findDeep(ServerStorage, "SharedModules")
findDeep(ServerStorage, "TradingUtils")

-- Also print entire ReplicatedStorage structure (shortened)
print("📁 Full ReplicatedStorage hierarchy:")
printHierarchy(ReplicatedStorage)

