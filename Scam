-- Debug: Show everything inside ReplicatedStorage (2 levels deep)

task.wait(2)  -- let the game load

local RS = game:GetService("ReplicatedStorage")

print("═══════════════════════════════════════")
print("🔍 CONTENTS OF REPLICATEDSTORAGE")
print("═══════════════════════════════════════")

-- List all top-level children
for _, child in ipairs(RS:GetChildren()) do
    print("📁 " .. child.Name .. " (" .. child.ClassName .. ")")
    
    -- If it's a folder or model, list its children (Level 2)
    if child:IsA("Folder") or child:IsA("Model") then
        for _, sub in ipairs(child:GetChildren()) do
            print("   └─ " .. sub.Name .. " (" .. sub.ClassName .. ")")
            
            -- If we find "TradingUtils", highlight it
            if string.lower(sub.Name) == "tradingutils" then
                warn("✅ FOUND TradingUtils at: " .. child.Name .. "." .. sub.Name)
            end
        end
    end
    
    -- If the top-level child itself is SharedModules or TradingUtils
    if string.lower(child.Name):find("shared") and string.lower(child.Name):find("module") then
        warn("✅ FOUND SharedModules at top level: " .. child.Name)
    end
    if string.lower(child.Name):find("tradingutils") then
        warn("✅ FOUND TradingUtils at top level: " .. child.Name)
    end
end

print("═══════════════════════════════════════")
print("✅ Debug complete. Check for ✅ or ❌ messages above.")
