-- LocalScript: AutoWithdrawUI (Corrected Path)

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ============================================
-- 1. CREATE THE UI
-- ============================================
local function createUI()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "AutoWithdrawUI"
    screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    -- Main Frame
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 220, 0, 120)
    frame.Position = UDim2.new(0, 15, 0, 15)
    frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    frame.BackgroundTransparency = 0.15
    frame.BorderSizePixel = 0
    frame.ClipsDescendants = true
    frame.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 28)
    title.Position = UDim2.new(0, 0, 0, 4)
    title.BackgroundTransparency = 1
    title.Text = "🤖 Auto-Withdraw"
    title.TextColor3 = Color3.fromRGB(220, 220, 255)
    title.TextSize = 16
    title.Font = Enum.Font.GothamBold
    title.Parent = frame

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, -20, 0, 24)
    status.Position = UDim2.new(0, 10, 0, 36)
    status.BackgroundTransparency = 1
    status.Text = "⏳ Initializing..."
    status.TextColor3 = Color3.fromRGB(200, 200, 200)
    status.TextSize = 14
    status.Font = Enum.Font.Gotham
    status.TextXAlignment = Enum.TextXAlignment.Left
    status.Parent = frame

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(1, -20, 0, 32)
    toggleBtn.Position = UDim2.new(0, 10, 0, 70)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.TextSize = 14
    toggleBtn.Font = Enum.Font.Gotham
    toggleBtn.Text = "▶ ENABLE"
    toggleBtn.Parent = frame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = toggleBtn

    return status, toggleBtn
end

local statusLabel, toggleButton = createUI()

-- ============================================
-- 2. FIND THE PATHS (WITH SHAREDMODULE)
-- ============================================

-- Step 1: Find the sharedmodule
local sharedModule = ReplicatedStorage:FindFirstChild("sharedmodule")
if not sharedModule then
    -- Fallback: maybe it's in Workspace?
    sharedModule = workspace:FindFirstChild("sharedmodule")
    if not sharedModule then
        statusLabel.Text = "❌ sharedmodule not found!"
        return
    end
end

-- Step 2: Find Game inside sharedmodule
local gameFolder = sharedModule:FindFirstChild("Game")
if not gameFolder then
    -- Fallback: try looking directly in ReplicatedStorage (just in case)
    gameFolder = ReplicatedStorage:FindFirstChild("Game")
    if not gameFolder then
        statusLabel.Text = "❌ Game folder not found inside sharedmodule!"
        return
    end
end

-- Step 3: Find TradingUtils
local tradingUtils = gameFolder:FindFirstChild("TradingUtils")
if not tradingUtils then
    statusLabel.Text = "❌ TradingUtils not found!"
    return
end

-- Get the required objects
local offer1 = tradingUtils:FindFirstChild("Offer1")      -- Folder
local ready2 = tradingUtils:FindFirstChild("Ready2")      -- BoolValue
local accept2 = tradingUtils:FindFirstChild("Accept2")    -- BoolValue
local player1Val = tradingUtils:FindFirstChild("Player1") -- StringValue / ObjectValue

if not offer1 or not ready2 or not accept2 then
    statusLabel.Text = "❌ Missing Offer1/Ready2/Accept2"
    return
end

-- ============================================
-- 3. CORE FUNCTIONS
-- ============================================

local scriptEnabled = false   -- start disabled
local hasWithdrawn = false

local function updateUI(statusText, buttonText, btnColor)
    statusLabel.Text = statusText
    if buttonText then
        toggleButton.Text = buttonText
    end
    if btnColor then
        toggleButton.BackgroundColor3 = btnColor
    end
end

local function removeMyOffer()
    if hasWithdrawn then return end
    hasWithdrawn = true

    -- Clear the folder
    for _, child in ipairs(offer1:GetChildren()) do
        child:Destroy()
    end

    updateUI("✅ Offer withdrawn! (P2 is ready & accepted)", "DISABLE", Color3.fromRGB(80, 80, 80))

    -- OPTIONAL: Fire Cancel RemoteEvent if it exists inside TradingUtils
    -- local cancelEvent = tradingUtils:FindFirstChild("CancelTrade")
    -- if cancelEvent and cancelEvent:IsA("RemoteEvent") then
    --     cancelEvent:FireServer()
    -- end
end

local function checkAndWithdraw()
    if not scriptEnabled then
        updateUI("⏸ PAUSED (click ENABLE)", "▶ ENABLE", Color3.fromRGB(60, 60, 80))
        return
    end

    if hasWithdrawn then
        updateUI("✅ Already withdrawn.", "DISABLE", Color3.fromRGB(80, 80, 80))
        return
    end

    -- Verify we are Player 1
    local isPlayer1 = false
    if player1Val then
        if player1Val:IsA("ObjectValue") and player1Val.Value == LocalPlayer then
            isPlayer1 = true
        elseif player1Val:IsA("StringValue") and player1Val.Value == LocalPlayer.Name then
            isPlayer1 = true
        elseif player1Val:IsA("StringValue") and player1Val.Value == tostring(LocalPlayer.UserId) then
            isPlayer1 = true
        end
    end

    if not isPlayer1 then
        updateUI("⛔ You are NOT Player 1", "DISABLE", Color3.fromRGB(80, 40, 40))
        return
    end

    -- Check Player 2's status
    local r2 = ready2.Value == true
    local a2 = accept2.Value == true

    if r2 and a2 then
        updateUI("⚡ Player 2 READY & ACCEPTED! Withdrawing...", "⏳ WAIT", Color3.fromRGB(200, 150, 0))
        task.wait(0.3)
        removeMyOffer()
    else
        local statusMsg = "👀 Waiting for P2... "
        if not r2 and not a2 then
            statusMsg = statusMsg .. "(Ready: ❌ | Accept: ❌)"
        elseif r2 and not a2 then
            statusMsg = statusMsg .. "(Ready: ✅ | Accept: ❌)"
        elseif not r2 and a2 then
            statusMsg = statusMsg .. "(Ready: ❌ | Accept: ✅)"
        end
        updateUI(statusMsg, "⏹ DISABLE", Color3.fromRGB(200, 60, 60))
    end
end

-- ============================================
-- 4. EVENT LISTENERS
-- ============================================

ready2:GetPropertyChangedSignal("Value"):Connect(checkAndWithdraw)
accept2:GetPropertyChangedSignal("Value"):Connect(checkAndWithdraw)

-- ============================================
-- 5. TOGGLE BUTTON
-- ============================================

toggleButton.MouseButton1Click:Connect(function()
    scriptEnabled = not scriptEnabled

    if scriptEnabled then
        hasWithdrawn = false
        updateUI("🟢 ENABLED – monitoring trade...", "⏹ DISABLE", Color3.fromRGB(200, 60, 60))
        checkAndWithdraw()
    else
        updateUI("🔴 DISABLED", "▶ ENABLE", Color3.fromRGB(60, 160, 60))
    end
end)

-- ============================================
-- 6. INITIAL STARTUP
-- ============================================

updateUI("🔴 DISABLED (press ENABLE)", "▶ ENABLE", Color3.fromRGB(60, 160, 60))

task.wait(1)
if scriptEnabled then
    checkAndWithdraw()
end

print("✅ Auto-Withdraw UI loaded. Path: ReplicatedStorage.sharedmodule.Game.TradingUtils")
