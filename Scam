local function IsAnyBossActuallyAlive()

    local zones =
        workspace:FindFirstChild(
            "Zones"
        )

    if not zones then
        return false
    end

    for flag, target in pairs(
        BossTargets
    ) do

        if BossLoops[flag] then

            local zone =
                zones:FindFirstChild(
                    target[1]
                )

            if zone then

                local enemies =
                    zone:FindFirstChild(
                        "Enemies"
                    )

                if enemies then

                    local boss =
                        enemies:FindFirstChild(
                            target[2]
                        )

                    if boss
                        and boss.Parent then

                        local humanoid =
                            boss:FindFirstChildOfClass(
                                "Humanoid"
                            )

                        if humanoid then

                            if humanoid.Health > 0 then
                                return true
                            end

                        else

                            return true

                        end

                    end

                end

            end

        end

    end

    return false

end

local function AttackBoss(
    flag,
    zoneName,
    enemyName
)

    local zones =
        workspace:FindFirstChild(
            "Zones"
        )

    if not zones then
        return
    end

    local zone =
        zones:FindFirstChild(
            zoneName
        )

    if not zone then
        return
    end

    local enemies =
        zone:FindFirstChild(
            "Enemies"
        )

    if not enemies then
        return
    end

    local pets = GetPets()

    if #pets == 0 then
        return
    end

    for _, enemy in ipairs(
        enemies:GetChildren()
    ) do

        if not BossLoops[flag] then
            return
        end

        if enemy.Name == enemyName
            and enemy.Parent then

            for _, pet in ipairs(
                pets
            ) do

                if not BossLoops[flag] then
                    return
                end

                if pet
                    and pet.Parent
                    and enemy.Parent then

                    pcall(function()

                        CombatRF:InvokeServer(
                            "AttackEnemy",
                            enemy,
                            pet
                        )

                    end)

                    task.wait(
                        GetAttackDelay()
                    )

                end

            end

        end

    end

end

