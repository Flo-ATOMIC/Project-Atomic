-- Helper: find a child by name, ignoring case
local function findIgnoreCase(parent, nameToFind)
    local lowerName = string.lower(nameToFind)
    for _, child in ipairs(parent:GetChildren()) do
        if string.lower(child.Name) == lowerName then
            return child
        end
    end
    return nil
end

