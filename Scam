local AutoFood = false
local FoodWorkerRunning = false

local function GetFoodSpawns()

    local zones =
        workspace:FindFirstChild(
            "Zones"
        )

    if not zones then
        return {}
    end

    local zone =
        zones:FindFirstChild(
            "Zone12.1"
        )

    if not zone then
        return {}
    end

    local foodSpawns =
        zone:FindFirstChild(
            "FoodSpawns"
        )

    if not foodSpawns then
        return {}
    end

    return foodSpawns:GetChildren()

end

local function StartFoodFarm()

    if FoodWorkerRunning then
        return
    end

    FoodWorkerRunning = true

    task.spawn(function()

        while AutoFood do

            if IsAnyBossActuallyAlive() then

                task.wait(0.05)

            else

                local foods =
                    GetFoodSpawns()

                for _, food in ipairs(
                    foods
                ) do

                    if not AutoFood then
                        break
                    end

                    if IsAnyBossActuallyAlive() then
                        break
                    end

                    if food
                        and food.Parent then

                        local pets =
                            GetPets()

                        for petIndex, pet in ipairs(
                            pets
                        ) do

                            if petIndex > 5 then
                                break
                            end

                            if not AutoFood then
                                break
                            end

                            if IsAnyBossActuallyAlive() then
                                break
                            end

                            if pet
                                and pet.Parent then

                                pcall(function()

                                    CollectionRF:InvokeServer(
                                        "CollectFood",
                                        food,
                                        pet
                                    )

                                end)

                            end

                        end

                    end

                end

                task.wait()

            end

        end

        FoodWorkerRunning = false

    end)

end

AutoHatchTab:CreateToggle({

    Name = "Auto Food",

    CurrentValue = false,

    Flag = "AutoFood",

    Callback = function(Value)

        AutoFood = Value

        if Value then
            StartFoodFarm()
        end

    end

})

