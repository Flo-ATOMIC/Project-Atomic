--------------------------------------------------
-- REMOVE FARM SOUNDS
--------------------------------------------------

local RemoveFarmSounds = false
local SoundConnection = nil

local function MuteSound(sound)

    pcall(function()
        sound.Volume = 0
    end)

end

local function MuteExistingSounds()

    for _, object in ipairs(
        game:GetDescendants()
    ) do

        if object:IsA("Sound") then

            MuteSound(object)

        end

    end

end

local function StartSoundRemover()

    if SoundConnection then

        SoundConnection:Disconnect()
        SoundConnection = nil

    end

    MuteExistingSounds()

    SoundConnection =
        game.DescendantAdded:Connect(
            function(object)

                if RemoveFarmSounds
                    and object:IsA("Sound") then

                    MuteSound(object)

                end

            end
        )

end

local function StopSoundRemover()

    if SoundConnection then

        SoundConnection:Disconnect()
        SoundConnection = nil

    end

end

AutoHatchTab:CreateToggle({

    Name = "Remove Farm Sounds",

    CurrentValue = false,

    Flag = "RemoveFarmSounds",

    Callback = function(Value)

        RemoveFarmSounds = Value

        if Value then

            StartSoundRemover()

        else

            StopSoundRemover()

        end

    end

})

