--------------------------------------------------
-- GET PETS
--------------------------------------------------

local function GetPets()

    local pets = {}

    if not PetsFolder
        or not PetsFolder.Parent then

        local currentPlayer =
            workspace:FindFirstChild(
                LocalPlayer.Name
            )

        if currentPlayer then

            local newPets =
                currentPlayer:FindFirstChild(
                    "Pets"
                )

            if newPets then

                Player = currentPlayer
                PetsFolder = newPets

            end

        end

    end

    if not PetsFolder
        or not PetsFolder.Parent then

        return pets

    end

    for _, pet in ipairs(
        PetsFolder:GetChildren()
    ) do

        if pet
            and pet.Parent then

            table.insert(
                pets,
                pet
            )

        end

    end

    return pets

end

