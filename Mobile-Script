local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local GuiService = game:GetService("GuiService")

-- 🎯 CONFIGURATION
local TARGET_PLAYER_NAME = "Flo_hitss"
local MAX_TRADES = 10           -- Nombre de trades avant arrêt
local TEMPS_ENTRE_2_TRADES = 15 -- Cooldown (mets 15 ou 20 si le jeu est strict)

-- ⚙️ CALIBRAGE DU CLIC (Si ça clique à côté sur mobile)
local OFFSET_X = 0 
local OFFSET_Y = 0 

-- 🐾 LISTE DES PETS
local SEARCH_ORDER = {
    "The Ethereal Everia", "The Grand Titan", "Frozen Dragon", "Enchanted Pegasus",
    "Great Auk", "The Frozen Ancient", "Lava Monster", "Ghost Pirate",
    "King Desert Slime", "Big 100M", "Naga", "Tiki", "Hornet",
    "Ice Serpent", "King Julian", "Inferno Bee", "Black Ice Bee"
}

local MAX_PETS = 6 

-- ⚙️ FONCTION DE CLIC LÉGÈRE (Sans VirtualUser)
local function lightClick(button)
    if not button then return end
    local inset = GuiService:GetGuiInset()
    local posX = button.AbsolutePosition.X + (button.AbsoluteSize.X / 2) + inset.X + OFFSET_X
    local posY = button.AbsolutePosition.Y + (button.AbsoluteSize.Y / 2) + inset.Y + OFFSET_Y
    
    -- Utilisation des fonctions natives de l'executor
    if mousemoveabs and mouse1click then
        pcall(function()
            mousemoveabs(posX, posY)
            task.wait(0.05)
            mouse1click()
        end)
    end
    task.wait(0.1)
end

-- =====================================================================
-- 🔄 BOUCLE PRINCIPALE
-- =====================================================================
for tradeNumber = 1, MAX_TRADES do
    print("🔄 Trade " .. tradeNumber .. "/" .. MAX_TRADES)
    
    local Mainscreen = PlayerGui:FindFirstChild("Mainscreen")
    local TradePlayerGui = PlayerGui:FindFirstChild("TradePlayer")
    local TradingGui = PlayerGui:FindFirstChild("Trading")
    
    -- Nettoyage de l'interface si elle est restée ouverte
    if TradingGui and TradingGui.Enabled then
        local closeTrade = TradingGui.Container.Frame:FindFirstChild("Close", true)
        if closeTrade then lightClick(closeTrade) task.wait(0.5) end
    end

    -- 1. Ouvrir le menu de sélection
    if Mainscreen and TradePlayerGui and not TradePlayerGui.Enabled then
        local blueButton = Mainscreen.Right:FindFirstChild("TradePlayer")
        if blueButton then
            lightClick(blueButton)
            task.wait(1) 
        end
    end

    -- 2. Chercher le bouton vert
    local targetGreenButton = nil
    if TradePlayerGui and TradePlayerGui.Enabled then
        local scrollingFrame = TradePlayerGui.Container.General.Frame.Frame.ScrollingFrame
        for _, obj in ipairs(scrollingFrame:GetDescendants()) do
            if obj:IsA("TextLabel") and string.find(string.lower(obj.Text), string.lower(TARGET_PLAYER_NAME)) then
                local parent = obj.Parent
                while parent and parent ~= scrollingFrame do
                    local btn = parent:FindFirstChild("Trade", true)
                    if btn and btn:IsA("TextButton") then
                        targetGreenButton = btn
                        break
                    end
                    parent = parent.Parent
                end
                if targetGreenButton then break end
            end
        end
    end

    if targetGreenButton then
        print("✅ Demande envoyée à " .. TARGET_PLAYER_NAME)
        lightClick(targetGreenButton)
        local closeBtn = TradePlayerGui.Container.General:FindFirstChild("Close", true)
        if closeBtn then task.wait(0.2) lightClick(closeBtn) end
        
        -- 3. Attendre l'acceptation
        print("⏳ Attente d'acceptation...")
        local waitTime = 0
        local tradeOuvert = false
        while waitTime < 40 do
            task.wait(1) -- 1 seconde pour laisser respirer le mobile
            waitTime = waitTime + 1
            local tg = PlayerGui:FindFirstChild("Trading")
            if tg and tg.Enabled then
                tradeOuvert = true
                break
            end
        end

        if tradeOuvert then
            print("🎉 Trade ouvert !")
            task.wait(1.5) -- On attend bien 1.5s que l'UI charge sur mobile

            local TradeFrame = TradingGui.Container.Frame
            local CurInventory = TradeFrame.CurInventory.ScrollingFrame
            local CurOffer = TradeFrame.CurOffer
            local SearchBar = TradeFrame.CurInventory.Search:FindFirstChildOfClass("TextBox")

            local function typeSearch(text)
                if SearchBar then
                    SearchBar:CaptureFocus()
                    SearchBar.Text = text
                    SearchBar:ReleaseFocus()
                end
            end

            local petsAdded = 0
            
            -- Ajout des pets
            for _, petName in ipairs(SEARCH_ORDER) do
                if petsAdded >= MAX_PETS or not TradingGui.Enabled then break end
                
                typeSearch(petName)
                task.wait(0.2) 
                
                local foundPet = nil
                for _, item in ipairs(CurInventory:GetChildren()) do
                    if string.find(string.lower(item.Name), string.lower(petName)) and not CurOffer:FindFirstChild(item.Name) then
                        foundPet = item
                        break
                    end
                end
                
                if foundPet then
                    local btn = foundPet:IsA("TextButton") and foundPet or foundPet:FindFirstChild("Frame")
                    if btn then
                        print("✅ Ajout : " .. foundPet.Name)
                        lightClick(btn)
                        petsAdded = petsAdded + 1
                        task.wait(0.4) -- Pause de sécurité pour que le mobile valide
                    end
                end
            end
            typeSearch("")

            -- 5. Ready et Confirmation
            if TradingGui.Enabled then
                local readyBtn = TradeFrame:FindFirstChild("Ready")
                if readyBtn then
                    print("⏳ Clic sur Ready !")
                    lightClick(readyBtn)
                    
                    local timer = 0
                    while timer < 20 do
                        task.wait(0.5) 
                        timer = timer + 0.5
                        
                        if not TradingGui.Enabled then break end -- L'autre joueur a annulé
                        
                        local acceptBtn = TradeFrame:FindFirstChild("Confirm") or TradeFrame:FindFirstChild("Accept")
                        if readyBtn and readyBtn.Text == "Accept" then acceptBtn = readyBtn end
                        
                        if acceptBtn then
                            print("✅ Clic sur Accepter !")
                            lightClick(acceptBtn)
                            print("🎉 Trade terminé !")
                            break
                        end
                    end
                end
            end
        else
            warn("❌ Pas d'acceptation.")
        end
    end
    
    -- Cooldown de sécurité
    if tradeNumber < MAX_TRADES then
        print("⏳ Cooldown de " .. TEMPS_ENTRE_2_TRADES .. " sec...")
        for i = TEMPS_ENTRE_2_TRADES, 1, -1 do
            task.wait(1)
        end
    end
end
print("Fin du script.")
