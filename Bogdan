-- Fonctionnement des attaque
local function safeAttackEnemy(enemy, pet)
    if CombatRemote then pcall(CombatRemote.InvokeServer, CombatRemote, "AttackEnemy", enemy, pet) end
end
local function safeCollectFood(food, pet)
    if CollectionRemote then pcall(CollectionRemote.InvokeServer, CollectionRemote, "CollectFood", food, pet) end
end

-- Ataque les ennemis
local function attackEnemiesInZone(zoneName, specificEnemy, attackAll)
    local zone = zoneCache[zoneName]
    if not zone then return end
    local enemiesObj = zone:FindFirstChild("Enemies")
    if not enemiesObj then return end
    local enemies
    if attackAll then
        enemies = enemiesObj:GetChildren()
    else
        local enemy = enemiesObj:FindFirstChild(specificEnemy)
        enemies = enemy and {enemy} or {}
    end
    if #enemies == 0 then return end
    local pets = updatePets()
    if #pets == 0 then return end
    if attackAll then
        -- Distribue les pets sur les ennemis autant que possible
        for i = 1, math.min(#pets, #enemies) do
            safeAttackEnemy(enemies[i], pets[i])
        end
    else
        -- Utilise le premier pet disponible pour attaquer tous les ennemis si ce n'est pas "attackAll"
        for _, pet in ipairs(pets) do
            safeAttackEnemy(enemies[1], pet) -- Attaque le premier ennemi trouvé
        end
    end
end

-- Attaquer les boss
local function attackBosses()
    if not config.farmBosses or #activeBosses == 0 then return end
    local pets = updatePets()
    if #pets == 0 then return end
    for _, boss in ipairs(activeBosses) do
        if boss and boss.Parent then
            -- Utilise le premier pet pour attaquer le boss
            safeAttackEnemy(boss, pets[1])
            task.wait(config.bossAttackDelay)
        end
    end
end

-- Collecter de la nourriture
local function collectFood()
    if not config.farmFood then return end
    for _, fz in ipairs(foodZones) do
        if fz.enabled then
            local zone = zoneCache[fz.zone]
            if zone then
                local foodSpawns = zone:FindFirstChild("FoodSpawns")
                if foodSpawns then
                    local foods = foodSpawns:GetChildren()
                    if #foods > 0 then
                        local pets = updatePets()
                        if #pets > 0 then
                            for fi, food in ipairs(foods) do
                                -- Utilise les pets en rotation pour collecter la nourriture
                                local pet = pets[((fi-1) % #pets) + 1]
                                safeCollectFood(food, pet)
                            end
                        end
                    end
                end
            end
        end
    end
end

-- Fonctionnement des oeufs
local function doPlanting()
    if not config.autoPlant or #eggsSelected == 0 or not PlantRemote then return end
    for _, zone in ipairs(eggsSelected) do
        -- Tenter plusieurs fois de planter par zone sélectionnée pour plus de réactivité
        for _ = 1, 5 do
            task.spawn(function() pcall(PlantRemote.FireServer, PlantRemote, zone) end)
        end
    end
end

local function doHatching()
    if not config.autoHatch or not HatchRemote then return end
    -- Tenter plusieurs éclosions à chaque appel de la tâche.
    -- Augmenté à 15 pour une vitesse maximale.
    for _ = 1, 15 do
        task.spawn(function()
            pcall(HatchRemote.FireServer, HatchRemote)
        end)
    end
end

local function doNests()
    if not config.autoNests or not FeedRemote then return end
    local nests = updateNests()
    if nests then
        for _, nest in ipairs(nests:GetChildren()) do
            -- Tenter plusieurs fois de nourrir chaque nid
            for _ = 1, 7 do
                task.spawn(function() pcall(FeedRemote.FireServer, FeedRemote, nest) end)
            end
        end
    end
end

-- Scan des boss
local function scanBosses()
    if not config.farmBosses then activeBosses = {}; return end
    local newActiveBosses = {}
    for _, name in ipairs(bossList) do
        if bossEnabled[name] then
            local zone = Workspace.Zones:FindFirstChild(bossZoneMap[name])
            if zone then
                local enemies = zone:FindFirstChild("Enemies")
                if enemies then
                    local enemy = enemies:FindFirstChild(name)
                    if enemy and enemy.Parent then table.insert(newActiveBosses, enemy) end
                end
            end
        end
    end
    activeBosses = newActiveBosses
end

-- Sacrifice
local function sacrificePet(petName)
    if SacrificeRemote then
        local success = pcall(function() SacrificeRemote:InvokeServer("SacrificeWell", petName) end)
        if success then
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Sacrifice", Text = petName .. " sacrifié !", Duration = 1.5
            })
        else
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Sacrifice", Text = "Échec du sacrifice de " .. petName .. ".", Duration = 1.5
            })
        end
    end
end
-- Système de tâches (loop principal)
local active = false
local mainThread = nil
local tasks = {}

local function addTask(name, func, interval, runNow)
    table.insert(tasks, { name = name, func = func, interval = interval, nextTime = runNow and 0 or os.clock() + interval })
end

local function mainLoop()
    while active do
        local now = os.clock()
        for i, task in ipairs(tasks) do
            if now >= task.nextTime then
                local s, e = pcall(task.func)
                if not s then warn("Task error [" .. task.name .. "]:", e) end
                task.nextTime = now + task.interval
            end
        end
        task.wait(0.01) -- Wait plus court pour une meilleure réactivité
    end
end

-- Commencer le farm
local function start()
    if active then return end
    active = true
    tasks = {}

    -- Pré-charger les zones (plus agressif)
    if ZonesRF then
        local zonesToLoad = {"Zone12.1", "SummerEventZone", "WinterEventZone", "ElementEventZone1", "Zone2", "Zone5", "Zone9", "Zone10", "Zone12"}
        for _, zoneName in ipairs(zonesToLoad) do
            pcall(ZonesRF.InvokeServer, ZonesRF, "RequestZoneMap", zoneName)
        end
    end

    -- Appliquer les optimisations dès le démarrage
    removeHatchAnimation()
    removeCoinsAnimation()

    -- Initialiser la vitesse de déplacement et le double saut
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = config.walkSpeed
        if config.doubleJump then
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            -- Reconnecter le double saut s'il y en a déjà une
            if not jumpConnection then
                jumpConnection = humanoid.Jumping:Connect(function()
                    jumpCount = jumpCount + 1
                    if jumpCount >= 2 then humanoid.Jump = true; jumpCount = 0 end
                end)
            end
        end
    end

    scanBosses()

    -- Tarefas
    addTask("bossScan", scanBosses, 5, true) -- Scan bosses plus souvent
    addTask("bossAttack", function() if config.farmBosses then attackBosses() end end, 0, false) -- Exécution continue
    addTask("enemyAttack", function() if config.farmEnemies then for idx, zoneInfo in ipairs(enemyZones) do if enemyEnabled[idx] then if zoneInfo.attackAll then attackEnemiesInZone(zoneInfo.zone, nil, true) else attackEnemiesInZone(zoneInfo.zone, zoneInfo.enemy, false) end end end end end, config.enemyDelay, false)
    addTask("foodCollect", function() if config.farmFood then collectFood() end end, config.foodDelay, false)
    addTask("plant", doPlanting, config.eggDelay, false)
    addTask("hatch", doHatching, config.eggDelay, false)
    addTask("nests", doNests, config.eggDelay, false)

    mainThread = task.spawn(mainLoop)
    Rayfield:Notify({ Title = "Project-Atomic", Content = "Farm Starting!", Duration = 3 })
end

local function stop()
    active = false
    if mainThread then task.cancel(mainThread); mainThread = nil end
    activeBosses = {}
    -- Réinitialiser la vitesse et le double saut si désactivé
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = 16 -- Vitesse par défaut
        if config.doubleJump and jumpConnection then
            jumpConnection:Disconnect()
            jumpConnection = nil
        end
    end
    Rayfield:Notify({ Title = "Project-Atomic", Content = "Farm Ended.", Duration = 2 })
end

